    "312시간 전"은 쓸모없다 — 상대 표기는 누적하지 않고 이틀에서 끊는다.
    export 된 정적 HTML 은 이 함수를 쓰지 않는다(생성 시점에 굳어 틀려진다).
    """
    if not ts:
        return ""
    try:
        t = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return ts[:16]
    now = datetime.now().astimezone()
    days = (now.date() - t.date()).days
    if days <= 0:
        secs = (now - t).total_seconds()
        if secs < 60:
            return "방금"
        if secs < 3600:
            return "%d분 전" % (secs // 60)
        return "%d시간 전" % (secs // 3600)
    if days == 1:
        return "어제 %s" % t.strftime("%H:%M")
    if t.year == now.year:
        return "%d월 %d일" % (t.month, t.day)
    return t.strftime("%Y-%m-%d")


# -------------------------------------------------------------------- serve


class Handler(BaseHTTPRequestHandler):
    dirs = []

    def log_message(self, *a):
        pass

    def _send(self, code, ctype, payload):
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        try:
            self.wfile.write(payload)
        except BrokenPipeError:
            pass

    def do_GET(self):
        path = unquote(urlparse(self.path).path)
        if path == "/":
            return self._send(200, "text/html; charset=utf-8", self.index())
        m = re.match(r"^/s/([\w.-]+)$", path)
        if m:
            return self.session_page(m.group(1))
        m = re.match(r"^/api/session/([\w.-]+)$", path)
        if m:
            s = self.find(m.group(1))
            if not s:
                return self._send(404, "application/json", '{"error":"not found"}')
            data = parse_session(s["path"])
            return self._send(
                200,
                "application/json; charset=utf-8",
                json.dumps(data, ensure_ascii=False),
            )
        self._send(404, "text/plain; charset=utf-8", "not found")

    def find(self, sid):
        for s in scan_sessions(self.dirs):
            if s["id"] == sid or s["id"].startswith(sid):
                return s
        return None

    def index(self):
        sessions = scan_sessions(self.dirs)
        groups = group_sessions(sessions)
        grouped = len(groups) > 1
        # 그룹 헤더에 경로가 있거나 전부 같은 프로젝트면 프로젝트 표기는 정보가 0이다
        show_project = not grouped and len({s["project"] for s in sessions}) > 1

        def rows(ss, label=""):
            out = []
            for s in ss:
                meta = [fmt_ago(s["started"] or "")]
                if s.get("turns"):
                    meta.append("%d턴" % s["turns"])
                if show_project and s["project"]:
                    meta.append(s["project"])
                if s["branch"]:
                    meta.append(s["branch"])
                if s.get("wt"):
                    meta.append("워크트리 · " + s["wt"])
                spans = "".join("<span>%s</span>" % html.escape(x) for x in meta)
                if s.get("pr"):
                    spans += '<span class="pr">#%d</span>' % s["pr"]
                badge = (
                    '<span class="cmd">%s</span>' % html.escape(s["badge"])
                    if s.get("badge")
                    else ""
                )
                out.append(
                    '<li data-q="%s" title="%s"><a href="/s/%s">'
                    '<div class="t">%s%s</div><div class="m">%s</div></a></li>'
                    % (
                        html.escape(
                            " ".join(
                                [
                                    s["title"], s.get("badge", ""), s["branch"],
                                    s.get("wt", ""), s["project"], label,
                                    "#%d" % s["pr"] if s.get("pr") else "",
                                ]
                            ).lower()
                        ),
                        html.escape(fmt_time(s["started"] or "")),
                        s["id"],
                        badge,
                        html.escape(s["title"]),
                        spans,
                    )
                )
            return "".join(out)

        if grouped:
            listing = "".join(
                '<details class="grp" data-path="%s"><summary>%s'
                '<span class="cnt">%d</span></summary><ul class="list">%s</ul>'
                "</details>"
                % (
                    html.escape(g["label"]),
                    html.escape(g["label"]),
                    len(g["sessions"]),
                    rows(g["sessions"], g["label"]),
                )
                for g in groups
            )
        else:
            listing = '<ul class="list">%s</ul>' % rows(sessions)
        body = (
            "<header><h1>Claude Code 세션</h1>"
            '<span class="sub">%d개</span>'
            '<div class="filters">'
            '<input type=search id=q placeholder="제목·브랜치%s 검색  ( / )"></div>'
            "</header>"
            '<div class="wrap">%s%s</div>'
            % (
                len(sessions),
                "·경로" if grouped else "",
                listing,
                '<div class="empty">세션 없음</div>' if not sessions else "",
            )
        )
        js = """
        const q = document.getElementById('q');
        const KEY = 'ccs-expanded';
        const stored = () => {
          try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); }
          catch (e) { return new Set(); }
        };
        let searching = false;
        document.querySelectorAll('details.grp').forEach(d => {
          if (stored().has(d.dataset.path)) d.open = true;
          d.addEventListener('toggle', () => {
            if (searching) return;
            const s = stored();
            d.open ? s.add(d.dataset.path) : s.delete(d.dataset.path);
            localStorage.setItem(KEY, JSON.stringify([...s]));
          });
        });
        // 하루에도 수십 번 여는 목록이다 — 검색은 키보드로 바로 잡되 애니메이션은 없다
        addEventListener('keydown', e => {
          const t = document.activeElement;
          const typing = t && /^(INPUT|TEXTAREA)$/.test(t.tagName);
          if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
            e.preventDefault(); q.focus(); q.select();
          } else if (e.key === 'Escape' && t === q) {
            if (q.value) { q.value = ''; q.dispatchEvent(new Event('input')); }
            else q.blur();
          }
        });
        q && q.addEventListener('input', () => {
          const v = q.value.trim().toLowerCase();
          searching = !!v;
          document.body.classList.add('searching');
          document.querySelectorAll('.list li').forEach(li =>
            li.classList.toggle('hidden', !!v && !li.dataset.q.includes(v)));
          const open = v ? null : stored();   // 키 입력마다 localStorage 를 다시 파싱하지 않는다
          document.querySelectorAll('details.grp').forEach(d => {
            const any = [...d.querySelectorAll('li')]
              .some(li => !li.classList.contains('hidden'));
            d.classList.toggle('hidden', !!v && !any);
            d.open = v ? true : open.has(d.dataset.path);
          });
          void document.body.offsetHeight;   // 여기까지를 전환 없이 확정시킨 뒤 되돌린다
          document.body.classList.remove('searching');
        });
        """
        return page("Claude Code 세션", body, js)

    def session_page(self, sid):
        s = self.find(sid)
        if not s:
            return self._send(404, "text/plain; charset=utf-8", "세션 없음")
        body = (
            "<header><a href='/' class='sub'>← 목록</a><h1>%s</h1>"
            '<span class="sub">%s</span>%s</header>'
            '<div class="wrap"><div id=app class="empty">불러오는 중…</div></div>'
            % (
                html.escape(s["title"]),
                html.escape(
                    " · ".join(x for x in [fmt_time(s["started"]), s["branch"]] if x)
                ),
                FILTERS_HTML,
            )
        )
        js = (
            "fetch('/api/session/%s').then(r=>r.json()).then(d=>"
            "renderSession(d, document.getElementById('app')));" % s["id"]
        )
        self._send(200, "text/html; charset=utf-8", page(s["title"], body, js))


def cmd_serve(args):
    dirs = resolve_dirs(args)
    Handler.dirs = dirs
    socketserver.TCPServer.allow_reuse_address = True
    port = args.port
    for attempt in range(20):
        try:
            httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError:
            port += 1
    else:
        sys.exit("빈 포트를 찾지 못했습니다.")
    url = "http://127.0.0.1:%d/" % port
    n = len(scan_sessions(dirs))
    print("세션 %d개 · %s" % (n, url))
    print("종료: Ctrl+C")
    if not args.no_open:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n종료")


# ------------------------------------------------------------------- export


def cmd_export(args):
    dirs = resolve_dirs(args)
    target = None
    for s in scan_sessions(dirs):
        if s["id"] == args.id or s["id"].startswith(args.id):
            target = s
            break
    if not target:
        sys.exit("세션을 찾지 못했습니다: %s" % args.id)

    data = parse_session(target["path"], redact=not args.no_redact)
    # 제목도 본문과 같은 마스킹을 통과한다 — 공유본에 홈 경로가 새면 안 된다
    title = target["title"] if args.no_redact else redact_text(target["title"])
    body = (
        "<header><h1>%s</h1><span class='sub'>%s</span>%s</header>"
        '<div class="wrap"><div id=app></div></div>'
        % (
            html.escape(title),
            html.escape(
                " · ".join(
                    x for x in [fmt_time(target["started"]), target["branch"]] if x
                )
            ),
            FILTERS_HTML,
        )
    )
    # 세션 본문에 </script> 가 들어 있으면 인라인 스크립트가 거기서 끊긴다.
    js = "const DATA=%s;renderSession(DATA, document.getElementById('app'));" % (
        json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    )
    out = args.out or ("%s.html" % target["id"][:8])
    with open(out, "w", encoding="utf-8") as f:
        f.write(page(title, body, js))
    size = os.path.getsize(out)
    print("%s (%s)" % (out, fmt_size(size)))
    print(
        "  프롬프트 %d · 응답 %d · 툴 %d%s"
        % (
            data["counts"]["user"],
            data["counts"]["assistant"],
            data["counts"]["tool"],
            "" if args.no_redact else " · 홈 경로 redact 적용",
        )
    )


def cmd_list(args):
    dirs = resolve_dirs(args)
    sessions = scan_sessions(dirs)
    for s in sessions:
        # 좁은 터미널에서도 표가 무너지지 않게 열 정렬을 유지한다.
        # 배지는 브라우저의 칩 대신 제목 앞 대괄호로 붙인다.
        title = "[%s] %s" % (s["badge"], s["title"]) if s["badge"] else s["title"]
        print(
            "%-10s %-16s %6s  %s"
            % (
                s["id"][:8],
                fmt_time(s["started"]),
                "%d턴" % s["turns"] if s["turns"] else "",
                title[:70],
            )
        )
    print("\n총 %d개" % len(sessions))


def main():
    # 서브커맨드 앞뒤 어디에 써도 먹도록 공통 옵션을 양쪽에 단다.
    # SUPPRESS 라서 지정하지 않은 쪽이 지정한 쪽을 덮어쓰지 않는다.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--dir", default=argparse.SUPPRESS, help="세션 디렉터리 직접 지정"
    )
    common.add_argument(
        "-a", "--all", action="store_true", default=argparse.SUPPRESS,
        help="모든 프로젝트 스캔",
    )

    ap = argparse.ArgumentParser(
        prog="ccs", parents=[common], description="Claude Code 세션 뷰어"
    )
    ap.set_defaults(func=cmd_serve, port=8787, no_open=False)
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("serve", parents=[common], help="브라우저로 열람")
    p.add_argument("--port", type=int, default=8787)
    p.add_argument("--no-open", action="store_true")
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser("list", parents=[common], help="세션 목록 출력")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("export", parents=[common], help="공유용 HTML 저장")
    p.add_argument("id", help="세션 id (앞부분만 써도 됨)")
    p.add_argument("-o", "--out", help="출력 파일")
    p.add_argument("--no-redact", action="store_true", help="홈 경로 마스킹 안 함")
    p.set_defaults(func=cmd_export)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
