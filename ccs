details.grp>summary::before{content:"▸";display:inline-block;
transition:transform 220ms var(--ease-out)}
details.grp[open]>summary::before{content:"▸";transform:rotate(90deg)}
details.grp>.list{padding:5px 0 12px}
/* 펼침은 머리줄 아래에서 자라 나온다 (::details-content 미지원이면 즉시 열림) */
details.grp::details-content{block-size:0;overflow:clip;
transition:block-size 220ms var(--ease-out),content-visibility 220ms allow-discrete}
details.grp[open]::details-content{block-size:auto}

/* ── 타임라인 레일 ─────────────────────────────────────────────── */
.turn{position:relative;margin:0 0 28px;scroll-margin-top:calc(var(--hh) + 12px)}
.turn::before{content:"";position:absolute;left:15px;top:8px;bottom:-20px;
width:2px;background:var(--line)}
.turn:last-of-type::before{display:none}
.ev{position:relative;margin:14px 0 14px 40px}

/* ── 발화 = 카드 + 헤더 스트립 ─────────────────────────────────── */
/* 카드는 "발화"에만 — 직계 자식으로 판정해야 사고 과정(details 안의 .md)이나
   명령·툴 결과가 지시 카드처럼 보이지 않는다.
   overflow는 visible이어야 레일 점(.ev::before)이 잘리지 않고 .who가 sticky가 된다 (03·04) */
.ev.user:has(>.bubble),.ev.assistant:has(>.md){background:var(--card);
border:1px solid var(--line);border-radius:8px;overflow:visible}
.ev.user:has(>.bubble)::before,.ev.assistant:has(>.md)::before{content:"";position:absolute;
left:-28.5px;top:12px;width:9px;height:9px;border-radius:50%;
background:var(--dim);outline:4px solid var(--bg)}
.ev.user:has(>.bubble)::before{background:var(--acc)}
.who{font-size:11px;font-weight:500;color:var(--dim);margin:0;padding:0 0 4px;
display:flex;gap:8px;align-items:center;text-transform:none;letter-spacing:0}
.ev.user:has(>.bubble)>.who,.ev.assistant:has(>.md)>.who{font-size:12px;font-weight:600;
color:var(--fg);padding:8px 14px;background:var(--head);
border-bottom:1px solid var(--line);border-radius:7px 7px 0 0}
.ev.user:has(>.bubble){border-color:var(--ubd)}
.ev.user:has(>.bubble)>.who{background:var(--uhead);border-bottom-color:var(--ubd);
color:var(--acc)}
.ev.user:has(>.bubble)>.who::before,.ev.assistant:has(>.md)>.who::before{content:"";
width:9px;height:9px;border-radius:50%;background:var(--acc);flex:none}
.ev.assistant:has(>.md)>.who::before{background:var(--dim)}
.badge{border:1px solid var(--line);border-radius:999px;padding:0 7px;font-size:11px;
font-weight:400;color:var(--dim)}
.user .bubble{background:none;border:none;border-radius:0;padding:12px 16px}
.user .bubble>.cmd{padding:2px 0}  /* 카드 패딩과 이중으로 들여쓰지 않는다 */
/* 슬래시 커맨드의 인자는 "내가 한 말"이다 — 활동줄의 인자와 같은 서체를 쓰면
   페이지에서 가장 중요한 글이 가장 작고 가장 안 읽히는 서체가 된다. 본문으로 되돌린다. */
.user .bubble>.cmd{font-size:15px;line-height:1.6;color:var(--fg)}
.user .bubble>.cmd .arg{font-family:inherit;font-size:inherit;color:var(--fg);
white-space:pre-wrap;word-break:keep-all;overflow-wrap:anywhere}
/* 카드도 활동줄도 아닌 이벤트(스킬 안내 등)의 역할 라벨은 잔해다 — 내용만 남긴다 */
.ev:not(.side):not(:has(>.bubble)):not(:has(>.md)):not(:has(>.ask))>.who{display:none}
.ev.assistant:has(>.md)>.md,.ev.assistant:has(>.md)>details,
.ev.assistant:has(>.md)>.cmd,.ev.assistant:has(>.md)>.fd{margin-left:16px;margin-right:16px}
.ev.assistant:has(>.md)>.md{margin-top:11px;margin-bottom:13px}
.ev.side{margin-left:64px}
.ev.side .who{font-size:11px}

/* ── 본문 타이포 ───────────────────────────────────────────────── */
.md{overflow-wrap:anywhere;word-break:keep-all}
.md p{margin:.55em 0}
.md ul,.md ol{margin:.4em 0;padding-left:1.3em}
.md code{background:var(--code);padding:1px 5px;border-radius:4px;font-size:.88em;
font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.md pre{background:var(--code);padding:11px 13px;border-radius:8px;overflow-x:auto;margin:.6em 0}
.md pre code{background:none;padding:0;font-size:13.5px;line-height:1.55}
/* 헤딩 레벨 복원 — 카드 안이라 위계는 굵기·여백이 지고 크기는 절제한다 (05) */
.md h1,.md h2,.md h3,.md h4,.md h5,.md h6{margin:1.5em 0 .5em;line-height:1.4;word-break:keep-all}
.md h1{font-size:1.18em;font-weight:700;letter-spacing:-.011em}
.md h2{font-size:1.06em;font-weight:700;letter-spacing:-.008em}
.md h3{font-size:1em;font-weight:680}
.md h4,.md h5,.md h6{font-size:.94em;font-weight:650;color:var(--dim)}
.md>:first-child{margin-top:0}
.md h1+*,.md h2+*,.md h3+*{margin-top:0}
/* 표 — 본문 폭을 넘으면 표만 가로로 흐르고 본문은 밀리지 않는다 (05) */
.md .tw{overflow-x:auto;margin:.85em 0;border:1px solid var(--line);border-radius:8px;
-webkit-overflow-scrolling:touch}
.md table{border-collapse:collapse;font-size:.92em;line-height:1.5;width:100%;
font-variant-numeric:tabular-nums}
.md th,.md td{padding:7px 12px;text-align:left;border-bottom:1px solid var(--line);
vertical-align:top;word-break:keep-all}
/* position:sticky 였으나 .tw 가 overflow-x:auto — 세로 스크롤이 없어 붙을 곳이 없었다 */
.md thead th{background:var(--head);font-weight:650;white-space:nowrap}
.md tbody tr:last-child td{border-bottom:0}
.md td code{white-space:nowrap}
/* 인용문 — 좌측 레일 하나로만 (카드 위에 또 카드를 얹지 않는다) */
.md blockquote{margin:.8em 0;padding:.1em 0 .1em 14px;border-left:2px solid var(--line);
color:var(--dim)}
.md blockquote>:first-child{margin-top:0}
.md blockquote>:last-child{margin-bottom:0}
.md hr{border:0;border-top:1px solid var(--line);margin:1.6em 0}
.md ul ul,.md ul ol,.md ol ul,.md ol ol{margin:.25em 0 .35em}
.md ul ul{list-style:circle}
.md ul ul ul{list-style:square}
.md li{margin:.18em 0}
.md li>p{margin:.3em 0}
.md li.task{list-style:none;margin-left:-1.15em}
.md li.task input{margin:0 7px 0 0;vertical-align:-1px;accent-color:var(--acc)}
/* 코드블록 — 하이라이팅 기각(05). 가로 스크롤 + 타이포만 */
.md pre.cb{overscroll-behavior-x:contain;tab-size:2}
.md pre.cb code{display:block;white-space:pre;min-width:min-content}
.md del{opacity:.55}
.md a{color:var(--acc);text-underline-offset:2px;
text-decoration-color:color-mix(in srgb,var(--acc) 35%,transparent)}

/* ── 활동: 카드 밖 타임라인 한 줄 ──────────────────────────────── */
details{border:none;margin:1px 0;background:none;border-radius:6px}
details>summary{cursor:pointer;padding:2px 8px;font-size:12px;color:var(--dim);
list-style:none;display:flex;gap:7px;align-items:center;border-radius:6px;
transition:background 120ms var(--ease-out)}
@media (hover:hover) and (pointer:fine){
details>summary:hover{background:color-mix(in srgb,var(--fg) 5%,transparent)}}
details>summary::-webkit-details-marker{display:none}
details>summary::before{content:"▸";font-size:9px;opacity:.7}
details[open]>summary::before{content:"▾"}
details[open]{background:var(--card);border:1px solid var(--line)}
/* 열리면 요약줄은 상자의 머리다 — 아래 모서리를 둥글게 두면 본문과 어긋나 보인다 */
details[open]>summary{border-radius:6px 6px 0 0}
details .body{padding:2px 10px 10px}
.tool summary strong{color:var(--dim);font-weight:600}
/* 흐리게는 색으로 — opacity:.8 은 --dim 을 3.7:1 로 떨어뜨려 11.5px 에서 AA 실패였다 */
.tool .arg{color:var(--dim);font-family:ui-monospace,Menlo,monospace;font-size:11.5px;
white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:560px}
.think summary{font-style:italic}
.err summary strong{color:var(--err)}
.cmd{font-size:12.5px;color:var(--dim);padding:2px 8px}
.cmd code{background:var(--code);padding:1px 6px;border-radius:4px;
font-family:ui-monospace,Menlo,monospace;color:var(--acc)}
.cmd .arg{font-family:ui-monospace,Menlo,monospace;font-size:11.5px}
pre.raw{background:var(--code);padding:9px 11px;border-radius:6px;overflow-x:auto;
font-size:12px;line-height:1.5;margin:0;white-space:pre-wrap;overflow-wrap:anywhere;
font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.ask{border:1px solid var(--line);border-left:3px solid var(--acc);background:var(--card);
border-radius:8px;padding:11px 14px;margin:6px 0}
.ask-q{font-weight:600;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ask-a{color:var(--acc);font-weight:600;margin:4px 0 12px}
.ask-a::before{content:"→ "}
.ask-a:last-child{margin-bottom:0}

/* ── 03 활동 버스트 압축 ───────────────────────────────────────── */
.burst{position:relative;margin:8px 0 8px 40px}
.burst::before{content:"";position:absolute;left:-28.5px;top:9px;width:9px;height:9px;
border-radius:50%;background:var(--bg);border:2px solid var(--line);
outline:4px solid var(--bg);box-sizing:border-box}
.burst.has-err::before{border-color:var(--err)}
.burst-h{display:flex;gap:9px;align-items:center;flex-wrap:wrap;cursor:pointer;
user-select:none;font-size:12px;line-height:1.45;color:var(--dim);
padding:4px 11px;border-radius:7px;border:1px solid transparent;
font-variant-numeric:tabular-nums;
transition:background 140ms var(--ease-out),border-color 140ms var(--ease-out),
transform 140ms var(--ease-out)}
@media (hover:hover) and (pointer:fine){
.burst-h:hover{background:color-mix(in srgb,var(--fg) 5%,transparent);border-color:var(--line)}}
.burst-h:active{transform:scale(.99)}
.burst-h:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
.burst-h::before{content:"▸";font-size:9px;opacity:.7;flex:none}
.burst.open>.burst-h::before{content:"▾"}
/* 펼친 헤더의 보더는 장식이 아니라 본문과 한 상자를 이루는 구조다 — 본문 좌우 보더는
   첫 프레임부터 solid 인데 헤더만 140ms 페이드하면 두 조각이 어긋나 보인다.
   열림 상태에서는 transition 목록에서 border-color 를 빼 같은 순간에 나타나게 한다. */
.burst.open>.burst-h{background:color-mix(in srgb,var(--fg) 4%,transparent);
border-color:var(--line);border-radius:7px 7px 0 0;
transition:background 140ms var(--ease-out),transform 140ms var(--ease-out)}
.b-n{font-weight:650;color:var(--fg)}
.b-sep{opacity:.4}
.b-err{color:var(--err);font-weight:600}
/* opacity:.65 였으나 --dim 대비를 2.8:1 로 떨어뜨렸다 (11px, AA 실패) */
.b-t{margin-left:auto;font-size:11px;white-space:nowrap}
/* 접힘은 hidden=until-found가 맡는다 — 브라우저 Ctrl+F가 안까지 찾는다 (04).
   테두리·패딩은 안쪽 래퍼로 내려야 접힌 상태에서 빈 상자가 남지 않는다. */
.burst-body{overflow:hidden}   /* 펼침 높이 애니메이션의 클리핑 상자 */
.burst-in{padding:4px 0 8px 10px;border:1px solid var(--line);border-top:none;
border-radius:0 0 7px 7px}
.burst-in>.ev{margin:1px 0}
.burst-in .ev>.who{display:none}
.burst-in .ev::before{display:none}
.b-all{display:flex;gap:10px;padding:2px 10px 6px;font-size:11px;color:var(--dim)}
.b-all button{all:unset;cursor:pointer;border-bottom:1px dotted var(--line);padding-bottom:1px;
transition:color 120ms var(--ease-out),border-color 120ms var(--ease-out),
transform 120ms var(--ease-out)}
@media (hover:hover) and (pointer:fine){
.b-all button:hover{color:var(--fg);border-color:var(--dim)}}
.b-all button:active{transform:scale(.97)}

/* ── 04 항해 장치: sticky 지시 헤더 · 진행바 · 턴 눈금 ──────────── */
/* sticky의 범위는 부모 상자다 — 지시 헤더가 턴 전체에서 고정되려면 카드 밖(턴의
   직계 자식)으로 승격돼야 한다. 승격은 setupNav의 렌더 후처리가 한다. */
.turn>.who.turn-head{position:sticky;top:var(--hh);z-index:3;margin:14px 0 0 40px;
font-size:12px;font-weight:600;color:var(--acc);padding:8px 14px;background:var(--uhead);
border:1px solid var(--ubd);border-radius:8px 8px 0 0;flex-wrap:nowrap}
.turn>.who.turn-head::before{content:"";width:9px;height:9px;border-radius:50%;
background:var(--acc);flex:none}
/* 헤더가 카드 밖으로 승격되면 카드는 "위가 열린 상자"가 돼야 한다. 그런데
   .ev.user:has(>.bubble) 의 :has() 가 특이도를 (0,3,0) 으로 끌어올려 border-radius:8px 와
   border:1px 가 그대로 이겼고, 결과적으로 상자 두 개가 겹쳐 보더가 깨져 있었다. */
.ev.user.turn-open:has(>.bubble),.ev.assistant.turn-open:has(>.md),
.ev.turn-open{margin-top:0;border-top:none;border-radius:0 0 8px 8px}
.ev.user.turn-open::before{top:-21px}
.who .ts,.who .tnav{font-weight:400;color:var(--dim)}
.who .ts::before,.who .tnav::before{content:"·";opacity:.45;margin-right:6px}
.who .ts{font-variant-numeric:tabular-nums}
.who .tnav b{font-weight:650;font-variant-numeric:tabular-nums;color:var(--acc)}
/* 시각·지시요약 교체 — display 스위치는 애니메이션이 불가능하고 행 너비까지 튄다.
   같은 grid cell 에 겹쳐두면 너비가 넓은 쪽으로 고정되고 opacity 만 오간다. */
.who .swap{display:grid;min-width:0;flex:1 1 auto}
.who .swap>*{grid-area:1/1;min-width:0;overflow:hidden;white-space:nowrap;
text-overflow:ellipsis;transition:opacity 90ms ease-out,filter 90ms ease-out}
/* 겹친 크로스페이드는 두 글자가 반투명하게 함께 읽히는 프레임을 만든다 —
   나가는 쪽을 먼저 보내고(0ms) 들어오는 쪽을 늦게(70ms) 띄우며 blur 로 틈을 메운다 */
.who .ts{transition-delay:70ms}
.who .tnav{opacity:0;filter:blur(2px)}
.who.stuck .ts{opacity:0;filter:blur(2px);transition-delay:0ms}
.who.stuck .tnav{opacity:1;filter:none;transition-delay:70ms}
.who.turn-head{transition:box-shadow 140ms ease}
/* -12px 스프레드는 실질적으로 안 보였다 — 본문이 헤더 밑을 그냥 통과해 보인다 */
.who.turn-head.stuck{box-shadow:0 6px 12px -8px rgba(0,0,0,.35)}
#prog{position:absolute;left:0;right:0;bottom:-1px;height:2px;pointer-events:none}
#progfill{height:2px;width:0;background:var(--acc);opacity:.9}
/* 이 페이지의 유일한 목차다 — 11×12px 히트 영역에 2×5px/50% 눈금은 실측상 겨냥이 안 됐다 */
.tick{all:unset;position:absolute;top:-7px;width:18px;height:16px;margin-left:-9px;
cursor:pointer;pointer-events:auto;display:flex;align-items:flex-end;justify-content:center}
.tick::before{content:"";width:2px;height:6px;border-radius:1px;background:var(--dim);
opacity:.7;transition:height 120ms var(--ease-out),opacity 120ms,background 120ms}
.tick:hover::before,.tick:focus-visible::before{height:11px;opacity:1;background:var(--acc)}
/* 눈금은 헤더 아래끝에 있다 — 툴팁은 아래로 자라야 origin 이 맞고, 세션 제목도 가리지 않는다 */
#progtip{position:absolute;top:10px;max-width:min(62vw,440px);background:var(--fg);
color:var(--bg);font-size:11.5px;line-height:1.45;padding:4px 9px;border-radius:6px;
white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none;opacity:0;
transform:translateY(-4px);transition:opacity 120ms,transform 120ms var(--ease-out);
box-shadow:0 4px 12px -6px rgba(0,0,0,.4)}
#progtip.on{opacity:1;transform:none}

/* ── diff 카드 ─────────────────────────────────────────────────── */
.fd{border:1px solid var(--line);border-radius:8px;margin:6px 0;background:var(--card);overflow:hidden}
/* flex-wrap:wrap + 절대경로라 카드 한 장이 3줄로 깨졌다 — 한 줄 고정, 파일명 우선 */
.fd>summary{display:flex;gap:7px;align-items:center;flex-wrap:nowrap;
padding:6px 11px;font-size:12px;color:var(--dim);cursor:pointer}
.fd>summary:hover{background:none}
.fh-tool{border:1px solid var(--line);border-radius:4px;padding:0 5px;font-size:11px;
text-transform:uppercase;letter-spacing:.03em;flex:none}
.fh-path{display:flex;align-items:baseline;min-width:0;flex:1 1 auto;overflow:hidden;
white-space:nowrap;font-family:ui-monospace,Menlo,monospace;font-size:11.5px}
.fh-path .dir{min-width:0;overflow:hidden;text-overflow:ellipsis;color:var(--dim)}
.fh-path b{flex:none;color:var(--fg);font-weight:600}
.fd>summary>.badge{flex:none}
.fh-stat{flex:none;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;white-space:nowrap}
.plus{color:var(--ok)}.minus{color:var(--err)}
table.dt{border-collapse:collapse;width:100%;font:12px/1.5 ui-monospace,Menlo,monospace;
border-top:1px solid var(--line);background:var(--card)}
.dt td{padding:0 8px;white-space:pre-wrap;overflow-wrap:anywhere;vertical-align:top}
.dt .ln{color:var(--dim);text-align:right;user-select:none;width:1%;min-width:30px;
font-size:10.5px;padding:1px 6px;border-right:1px solid var(--line)}
.dt tr.add{background:color-mix(in srgb,var(--ok) 13%,transparent)}
.dt tr.del{background:color-mix(in srgb,var(--err) 11%,transparent)}
.dt tr.hh td{color:var(--dim);background:var(--code);padding:2px 8px;font-size:11px}

/* ── hunk-review 리뷰 스레드 카드·리뷰 탭 ──────────────────────── */
.rv{border:1px solid var(--ubd);border-left:3px solid var(--acc);border-radius:8px;
margin:10px 0;background:var(--card);overflow:hidden}
.rv-h{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:7px 11px;
font-size:12px;color:var(--dim);border-bottom:1px solid var(--line)}
.rv-h .fh-path{font-size:11.5px}
.rv-anchor{font-family:ui-monospace,Menlo,monospace;font-size:11px}
.rv-state{margin-left:auto;font-size:10.5px;border:1px solid var(--line);
border-radius:999px;padding:0 7px}
.rv-state.done{color:var(--ok);border-color:var(--ok)}
.rv-state.open{color:var(--warn);border-color:var(--warn)}
.rv-body{padding:4px 11px 9px}
.rv-c{background:var(--uhead);border:1px solid var(--ubd);border-radius:8px;
padding:8px 11px;margin:7px 0}
.rv-c .who-s{font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;
color:var(--dim);margin-bottom:2px}
.rv-r{border:1px solid var(--line);border-radius:8px;padding:8px 11px;margin:7px 0;
background:var(--bg)}
.rv-r .sum{font-weight:600}
.rv-r .rat{color:var(--dim);font-size:12.5px;margin-top:3px}
.rv .fd{margin:7px 0}
.rv-label{font-size:10.5px;color:var(--dim);margin:7px 0 -3px}
.rv.rv-agent{border-color:var(--line);border-left-color:var(--dim)}
