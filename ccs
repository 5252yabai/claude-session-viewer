#!/usr/bin/env python3
"""ccs - Claude Code Session viewer.

~/.claude/projects/<project>/*.jsonl 을 읽어 브라우저로 열람하고,
공유용 self-contained HTML 로 내보낸다.

  ccs serve                 현재 프로젝트 세션을 로컬 서버로 열람
  ccs serve --all           모든 프로젝트
  ccs list                  세션 목록만 출력
  ccs export <id> -o a.html 세션 하나를 self-contained HTML 로 저장
"""

import argparse
import html
import json
import os
import re
import socketserver
import sys
import threading
import webbrowser
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlparse

HOME = os.path.expanduser("~")
PROJECTS_ROOT = os.path.join(HOME, ".claude", "projects")
MAX_STR = 12000  # 문자열 파트 1개당 상한
TITLE_SCAN_LINES = 3000
# 목록 요약 캐시의 스키마 버전. 제목·턴 계산 규칙을 바꾸면 올린다(옛 항목은 조용히 버려진다).
CACHE_VERSION = 1


# ---------------------------------------------------------------- discovery


def project_dir_for(cwd):
    """/Users/a/b -> ~/.claude/projects/-Users-a-b"""
    slug = cwd.replace("/", "-")
    return os.path.join(PROJECTS_ROOT, slug)


def all_project_dirs():
    if not os.path.isdir(PROJECTS_ROOT):
        return []
    return sorted(
        os.path.join(PROJECTS_ROOT, d)
        for d in os.listdir(PROJECTS_ROOT)
        if os.path.isdir(os.path.join(PROJECTS_ROOT, d))
    )


def resolve_dirs(args):
    if getattr(args, "dir", None):
        return [os.path.abspath(os.path.expanduser(args.dir))]
    if getattr(args, "all", False):
        return all_project_dirs()
    d = project_dir_for(os.getcwd())
    if os.path.isdir(d):
        return [d]
    every = all_project_dirs()
    if not every:
        sys.exit("세션이 하나도 없습니다: %s" % PROJECTS_ROOT)
    print("현재 위치에 세션 없음 → 전체 프로젝트 %d개로 대체" % len(every), file=sys.stderr)
    return every


def scan_sessions(dirs):
    """세션 파일 전체를 파싱하지 않고 목록용 요약만 만든다.

    세션 파일은 append-only 라 (경로, size, mtime) 이 같으면 내용도 같다 —
    캐시가 맞으면 파일을 열지 않는다. 캐시는 순수 최적화라 통째로 없어도
    결과는 같다(느려질 뿐).
    """
    cache = load_cache()
    seen, dirty, out = {}, False, []
    for d in dirs:
        if not os.path.isdir(d):
            continue
        project = os.path.basename(d)
        for name in os.listdir(d):
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(d, name)
            try:
                st = os.stat(path)
            except OSError:
                continue
            if st.st_size == 0:
                continue
            hit = cache.get(path)
            if not (
                isinstance(hit, dict)
                and hit.get("size") == st.st_size
                and hit.get("mtime") == st.st_mtime
            ):
                hit = summarize(path, st)
                dirty = True
            seen[path] = hit
            s = dict(hit)  # 캐시 항목은 그대로 두고 사본에만 표시용 필드를 얹는다
            s["id"] = name[:-6]
            s["path"] = path
            s["project"] = os.path.basename(s["cwd"]) or project
            out.append(s)
    if dirty:
        cache.update(seen)
        save_cache(cache)
    # 표시하는 값(시작 시각)과 정렬 기준을 맞춘다. 시작 시각이 없으면 mtime 으로.
    out.sort(key=lambda s: (s["started"] or "", s["mtime"]), reverse=True)
    return out


def summarize(path, st):
    """세션 파일 하나를 읽어 목록 한 줄에 필요한 값을 전부 만든다(캐시 미스 경로)."""
    head = peek(path)
    tail = peek_tail(path)
    return {
        "size": st.st_size,
        "mtime": st.st_mtime,
        "title": tail["ai_title"] or head["title"] or "(제목 없음)",
        "badge": head["badge"],
        "pr": tail["pr"],
        "turns": count_turns(path),
        "cwd": head["cwd"],
        "cwd_last": tail["cwd"] or head["cwd"],
        "branch": tail["branch"] or head["branch"],
        "started": head["started"],
    }


# --------------------------------------------------------------- scan cache


def cache_path():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    return os.path.join(base, "ccs", "scan.json")


def load_cache():
    """손상·버전 불일치는 조용히 빈 캐시로 취급한다. 정확성의 소스가 아니다."""
    try:
        with open(cache_path(), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict) or data.get("v") != CACHE_VERSION:
        return {}
    sessions = data.get("sessions")
    return sessions if isinstance(sessions, dict) else {}


def save_cache(entries):
    """사라진 세션은 털어내고 원자적으로 쓴다. 실패는 무시한다 — 캐시일 뿐이다."""
    path = cache_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        alive = {k: v for k, v in entries.items() if os.path.exists(k)}
        tmp = "%s.%d.tmp" % (path, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"v": CACHE_VERSION, "sessions": alive}, f, ensure_ascii=False)
        os.replace(tmp, path)
    except OSError:
        pass


def peek(path):
    """앞부분만 읽어 배지/제목/브랜치/시작시각을 뽑는다.

    제목감이 없는 프롬프트(/clear · /model opus 단독 등)에서 멈추지 않고
    다음 프롬프트로 넘어간다. 슬래시 커맨드는 제목 본문이 아니라 배지가 된다.
    """
    badge, title, cwd, branch, started = "", "", "", "", ""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for n, line in enumerate(f):
                if n > TITLE_SCAN_LINES:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if not started:
                    started = e.get("timestamp") or ""
                cwd = cwd or e.get("cwd") or ""
                branch = branch or e.get("gitBranch") or ""
                if title or e.get("type") != "user" or e.get("isSidechain"):
                    continue
                if e.get("isMeta"):
                    continue
                content = (e.get("message") or {}).get("content")
                if isinstance(content, list) and any(
                    isinstance(p, dict) and p.get("type") == "tool_result"
                    for p in content
                ):
                    continue  # 도구 결과는 턴을 열지 않는다 — 제목감도 아니다
                cand_badge, cand = prompt_title(first_text(e.get("message", {})))
                badge = badge or cand_badge
                if cand:
                    title = cand
                    if started:
                        break
    except OSError:
        pass
    return {"badge": badge, "title": title, "cwd": cwd, "branch": branch,
            "started": started}


def peek_tail(path, size=65536):
    """끝부분만 읽어 마지막 cwd/브랜치 · ai-title · PR 번호를 뽑는다.

    Claude Code 가 턴마다 갱신해 append 하는 ai-title 과 pr-link 는 실측상
    100% 이 청크 안에 있다 — 추가 파일 읽기 없이 제목과 PR 배지를 얻는다.
    역순 순회라 처음 만나는 것이 파일에서 마지막 것이다.
    """
    empty = {"cwd": "", "branch": "", "ai_title": "", "pr": 0}
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - size))
            chunk = f.read().decode("utf-8", "replace")
    except OSError:
        return empty
    got = dict(empty)
    for line in reversed(chunk.splitlines()):
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue  # 청크 첫 줄은 잘려 있을 수 있다
        etype = e.get("type")
        if etype == "ai-title":
            got["ai_title"] = got["ai_title"] or (e.get("aiTitle") or "")
            continue
        if etype == "pr-link":
            got["pr"] = got["pr"] or (e.get("prNumber") or 0)
            continue
        got["cwd"] = got["cwd"] or e.get("cwd") or ""
        got["branch"] = got["branch"] or e.get("gitBranch") or ""
    return got


def count_turns(path):
    """세션 전체를 훑어 턴 수를 센다 — 상세 화면의 진행바·턴 번호와 같은 정의.

    턴을 여는 프롬프트는 파일 전역에 흩어져 있어 앞뒤 청크만으로는 못 센다.
    유일하게 전체 읽기가 필요한 값이라 결과를 캐시한다. 바이트 단계에서
    유저 이벤트가 아닌 줄을 걸러 json 파싱 비용을 줄인다.
    """
    turns = 0
    try:
        with open(path, "rb") as f:
            for raw in f:
                if b'"user"' not in raw:
                    continue
                try:
                    e = json.loads(raw)
                except ValueError:
                    continue
                if e.get("type") != "user" or e.get("isSidechain") or e.get("isMeta"):
                    continue
                content = (e.get("message") or {}).get("content")
                if isinstance(content, str):
                    content = [{"type": "text", "text": content}]
                if isinstance(content, list) and opens_turn(content):
                    turns += 1
    except OSError:
        return 0
    return turns


def first_text(message):
    c = message.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        for p in c:
            if isinstance(p, dict) and p.get("type") == "text":
                return p.get("text") or ""
    return ""


NOISE_RE = re.compile(
    r"<(system-reminder|command-message|command-name|command-args"
    r"|local-command-\w+|task-notification)>.*?</\1>",
    re.S,
)
CMD_RE = re.compile(r"<command-name>\s*(.*?)\s*</command-name>", re.S)
CMD_ARGS_RE = re.compile(r"<command-args>\s*(.*?)\s*</command-args>", re.S)
STDOUT_RE = re.compile(r"<local-command-stdout>(.*?)</local-command-stdout>", re.S)
SKIP_TITLES = ("[Request interrupted by user]", "[Request interrupted by user for tool use]")
SKILL_PREFIX = "Base directory for this skill: "


def strip_noise(text):
    return NOISE_RE.sub("", text or "")


CONTINUED_PREFIX = "This session is being continued"
INTERRUPT_PREFIX = "[Request interrupted"
# 첫 토큰이 통째로 커맨드 이름이어야 커맨드다. /Users/… · /var/… 로 시작하는
# 지시는 경로일 뿐이고, 실측 22건 중 16건이 그쪽이었다.
SLASH_CMD_RE = re.compile(r"^/[A-Za-z][\w:-]*(\s|$)")


def is_slash_command(body):
    return bool(SLASH_CMD_RE.match(body))


def opens_turn(content):
    """진짜 지시만 턴을 연다. (04 결정 — 진행바 분모·턴 번호·sticky 라벨의 공통 재료)

    /명령 단독 · compact 승계문 · <…> 시스템 주입 · [Request interrupted…] 는
    턴을 열지 않고 앞 턴에 속한다.
    """
    if any(isinstance(p, dict) and p.get("type") == "tool_result" for p in content):
        return False
    texts = [p.get("text") or "" for p in content
             if isinstance(p, dict) and p.get("type") == "text"]
    if not texts:
        return False
    body = strip_noise("\n".join(texts)).strip()
    if not body or is_slash_command(body):
        return False
    return not body.startswith(("<", CONTINUED_PREFIX, INTERRUPT_PREFIX))


# 주제를 담지 않는 세션 제어·설정 커맨드. 배지도 제목도 되지 못하고 다음 프롬프트에
# 자리를 넘긴다. 실측상 첫 프롬프트의 70%가 /clear 다.
CONTROL_CMDS = {
    "add-dir", "agents", "allowed-tools", "bashes", "bug", "clear", "compact",
    "config", "context", "cost", "doctor", "effort", "exit", "fast", "help",
    "hooks", "ide", "install-github-app", "login", "logout", "mcp", "memory",
    "migrate-installer", "model", "output-style", "permissions", "plugin",
    "privacy-settings", "quit", "release-notes", "resume", "rewind", "sandbox",
    "statusline", "status", "terminal-setup", "theme", "todos", "upgrade",
    "usage", "vim",
}
IMAGE_RE = re.compile(r"\[Image #\d+\]")
AT_PATH_RE = re.compile(r"@\S*/(\S+)")


def title_text(raw):
    """제목 본문을 정리한다 — 이미지 참조는 버리고 @긴경로는 파일명만 남긴다.

    표시 폭은 좁다. 앞자리를 경로·이미지 번호가 먹으면 실제 주제가 잘려나간다.
    """
    text = IMAGE_RE.sub(" ", raw or "")
    text = AT_PATH_RE.sub(lambda m: "@" + m.group(1), text)
    return " ".join(text.split())[:120]


def prompt_title(raw):
    """유저 프롬프트에서 (배지, 제목)을 뽑는다.

    슬래시 커맨드는 제목 본문에서 빼내 배지로 돌려준다 — 좁은 폭을 커맨드
    이름이 먹지 않게. 배지에는 마지막 세그먼트만 쓴다
    (/mattpocock-skills:wayfinder → wayfinder).
    제목감이 아니면 제목은 빈 문자열이고, 호출부가 다음 프롬프트로 넘어간다.
    """
    raw = raw or ""
    cmd = CMD_RE.search(raw)
    if cmd:
        name = " ".join(cmd.group(1).split()).lstrip("/")
        base = name.split(":")[-1].split()[0] if name.strip() else ""
        if not base or base in CONTROL_CMDS:
            return "", ""
        args = CMD_ARGS_RE.search(raw)
        return base, title_text(args.group(1) if args else "")
    body = strip_noise(raw).strip()
    if not body or body in SKIP_TITLES:
        return "", ""
    # 턴 정의(opens_turn)와 같은 기준 — 여기서 어긋나면 목록과 상세가 갈라진다
    if is_slash_command(body) or body.startswith(
        ("<", CONTINUED_PREFIX, INTERRUPT_PREFIX)
    ):
        return "", ""
    return "", title_text(body)


def _cwd_label(cwd, sessions):
    if not cwd:
        return sessions[0]["project"]
    if cwd == HOME:
        return "~"
    if cwd.startswith(HOME + "/"):
        return "~" + cwd[len(HOME):]
    return cwd


GIT_WT_MARKER = "/.git/worktrees/"


def _gitdir_repo(git_file, at):
    """워크트리 .git 파일의 gitdir 포인터에서 원본 repo 루트를 뽑는다."""
    try:
        with open(git_file, encoding="utf-8", errors="replace") as f:
            line = f.readline().strip()
    except OSError:
        return ""
    if not line.startswith("gitdir:"):
        return ""
    gd = line[len("gitdir:"):].strip()
    if not os.path.isabs(gd):
        gd = os.path.normpath(os.path.join(at, gd))
    i = gd.find(GIT_WT_MARKER)
    return gd[:i] if i > 0 else ""


def _resolve_repo(cwd):
    """cwd에서 상향탐색하며 .git을 찾아 (repo 루트, 워크트리 디렉토리)를 돌려준다.

    .git 디렉토리면 메인 repo, gitdir 포인터 파일이면 워크트리.
    git 서브프로세스보다 ~300배 싸고 결과는 같다. 미판별은 ("", "").
    """
    d = cwd
    while d and d != "/":
        g = os.path.join(d, ".git")
        if os.path.isdir(g):
            return d, ""
        if os.path.isfile(g):
            root = _gitdir_repo(g, d)
            if root:
                return root, d
        d = os.path.dirname(d)
    return "", ""


def _worktree_index(roots):
    """repo 쪽 .git/worktrees/*/gitdir 역인덱스: 삭제된 워크트리 경로 -> repo."""
    idx = {}
    for root in roots:
        wt_dir = os.path.join(root, ".git", "worktrees")
        try:
            names = os.listdir(wt_dir)
        except OSError:
            continue
        for n in names:
            try:
                with open(os.path.join(wt_dir, n, "gitdir")) as f:
                    p = f.read().strip()
            except OSError:
                continue
            if p.endswith("/.git"):
                idx[p[: -len("/.git")]] = root
    return idx


def _heuristic_repo(cwd, roots):
    """워크트리 생성 규칙 역산: <repo>/.claude/worktrees → herdr → ~/.wt 최장 prefix."""
    i = cwd.find("/.claude/worktrees/")
    if i > 0:
        name = cwd[i + len("/.claude/worktrees/"):].split("/", 1)[0]
        return cwd[:i], cwd[:i] + "/.claude/worktrees/" + name
    by_name = {os.path.basename(r): r for r in roots}
    herdr = HOME + "/.herdr/worktrees/"
    if cwd.startswith(herdr):
        segs = cwd[len(herdr):].split("/")
        if len(segs) >= 2 and segs[0] in by_name:
            return by_name[segs[0]], herdr + segs[0] + "/" + segs[1]
    wt = HOME + "/.wt/"
    if cwd.startswith(wt):
        leaf = cwd[len(wt):].split("/", 1)[0]
        best = ""
        for name in by_name:
            if (leaf == name or leaf.startswith(name + "-")) and len(name) > len(best):
                best = name
        if best:
            return by_name[best], wt + leaf
    return "", ""


def group_sessions(sessions):
    """같은 repo의 메인·워크트리 세션을 한 그룹으로 묶는다. 그룹 안 최신순 유지.

    판별 순서: .git 상향탐색 → repo 역인덱스(삭제된 워크트리) → 경로 휴리스틱
    → 미판별은 cwd 단독 그룹. 워크트리 세션에는 wt(디렉토리명) 배지를 단다.
    """
    repo = {}  # cwd -> (repo 루트, 워크트리 디렉토리)
    for s in sessions:
        cwd = s.get("cwd_last") or s["cwd"]
        if cwd and cwd not in repo:
            repo[cwd] = _resolve_repo(cwd)
    known = sorted({r for r, _ in repo.values() if r})
    idx = None
    for cwd, (root, _) in list(repo.items()):
        if root:
            continue
        if idx is None:
            idx = _worktree_index(known)
        hit = next(
            ((r, w) for w, r in idx.items() if cwd == w or cwd.startswith(w + "/")),
            None,
        )
        repo[cwd] = hit or _heuristic_repo(cwd, known)
    by_root = {}
    for s in sessions:
        cwd = s.get("cwd_last") or s["cwd"]
        root, wt = repo.get(cwd, ("", ""))
        s["wt"] = os.path.basename(wt) if root and wt else ""
        by_root.setdefault(root or cwd, []).append(s)
    groups = [
        {"label": _cwd_label(key, ss), "sessions": ss}
        for key, ss in by_root.items()
    ]
    # scan_sessions 와 같은 최신순 기준: 그룹의 가장 최근 세션이 위로.
    groups.sort(
        key=lambda g: max((s["started"] or "", s["mtime"]) for s in g["sessions"]),
        reverse=True,
    )
    return groups


# ------------------------------------------------------------------ parsing


def clip(s):
    if not isinstance(s, str):
        s = json.dumps(s, ensure_ascii=False)
    if len(s) > MAX_STR:
        return s[:MAX_STR] + "\n\n… (%s자 잘림)" % (len(s) - MAX_STR)
    return s


def result_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        chunks = []
        for p in content:
            if not isinstance(p, dict):
                chunks.append(str(p))
            elif p.get("type") == "text":
                chunks.append(p.get("text") or "")
            elif p.get("type") == "image":
                chunks.append("(이미지)")
            else:
                chunks.append(json.dumps(p, ensure_ascii=False))
        return "\n".join(chunks)
    if content is None:
        return ""
    return json.dumps(content, ensure_ascii=False)


def file_diff_part(tool, tur, is_error):
    """Edit/Write 성공 결과의 toolUseResult -> diff 렌더용 파트. 아니면 None."""
    if tool not in ("Edit", "Write") or is_error or not isinstance(tur, dict):
        return None
    part = {
        "type": "file_diff",
        "tool": tool,
        "file": tur.get("filePath") or "",
        "patch": tur.get("structuredPatch") or [],
        "create": tur.get("type") == "create",
        "userModified": bool(tur.get("userModified")),
    }
    if part["create"]:
        part["content"] = clip(tur.get("content") or "")
    return part


def _agent_file_diffs(path):
    """서브에이전트 jsonl에서 Edit/Write 성공 diff 파트만 뽑는다."""
    diffs, ts, names = [], "", {}
    try:
        f = open(path, "r", encoding="utf-8", errors="replace")
    except OSError:
        return diffs, ts
    with f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            content = (e.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for p in content:
                if not isinstance(p, dict):
                    continue
                if p.get("type") == "tool_use":
                    names[p.get("id")] = p.get("name")
                elif p.get("type") == "tool_result":
                    fd = file_diff_part(
                        names.get(p.get("tool_use_id"), ""),
                        e.get("toolUseResult"),
                        bool(p.get("is_error")),
                    )
                    if fd:
                        diffs.append(fd)
                        ts = e.get("timestamp") or ts
    return diffs, ts


def _subagent_events(session_path, tool_turns, last_turn):
    """<sessionId>/subagents/agent-*.jsonl -> 부모 턴에 붙일 사이드체인 이벤트."""
    sub = os.path.join(session_path[:-6], "subagents")
    try:
        names = sorted(n for n in os.listdir(sub) if n.endswith(".jsonl"))
    except OSError:
        return []
    out = []
    for n in names:
        try:
            with open(os.path.join(sub, n[:-6] + ".meta.json")) as f:
                meta = json.load(f)
        except (OSError, ValueError):
            meta = {}
        diffs, ts = _agent_file_diffs(os.path.join(sub, n))
        if not diffs:
            continue
        out.append(
            {
                "role": "assistant",
                "ts": ts,
                "side": True,
                "meta": False,
                "model": "",
                "skill": "",
                "agent": meta.get("description") or "서브에이전트",
                "turn": tool_turns.get(meta.get("toolUseId"), last_turn),
                "parts": diffs,
            }
        )
    return out


HUNK_CMD_RE = re.compile(r"\bhunk\s+session\b")
HUNK_LIST_HEAD_RE = re.compile(r"^(user:\d+(?:-\d+)?)\s+(\S+)\s+\[user\]$", re.M)


def _hunk_kind(cmd):
    """hunk CLI 명령 분류. hunk 명령이 아니면 ''. (01 파싱 규칙)"""
    if not HUNK_CMD_RE.search(cmd or ""):
        return ""
    for key, kind in (
        ("comment apply", "apply"),
        ("comment add", "add"),
        ("comment list", "list"),
        ("session review", "review"),
        ("session reload", "reload"),
    ):
        if key in cmd:
            return kind
    return "other"


def _parse_comment_list(stdout):
    """comment list stdout(텍스트/JSON) -> user 코멘트 배열."""
    out = []
    if (stdout or "").lstrip().startswith("{"):
        try:
            comments = json.loads(stdout).get("comments") or []
        except ValueError:
            comments = []
        for c in comments:
            if not isinstance(c, dict) or c.get("source") != "user":
                continue
            out.append(
                {"id": c.get("noteId") or "", "file": c.get("filePath") or "",
                 "hunk": c.get("hunkIndex"), "range": c.get("newRange"),
                 "body": c.get("body") or "", "created": c.get("createdAt") or ""}
            )
        return out
    for m in HUNK_LIST_HEAD_RE.finditer(stdout or ""):
        c = {"id": m.group(1), "file": m.group(2), "hunk": None,
             "range": None, "body": "", "created": ""}
        body_lines, in_body = [], False
        for line in stdout[m.end():].splitlines()[1:]:
            if not line.strip() or HUNK_LIST_HEAD_RE.match(line):
                break
            f = line.strip()
            if f.startswith("hunk:"):
                in_body = False
                try:
                    c["hunk"] = int(f[len("hunk:"):].strip())
                except ValueError:
                    pass
            elif f.startswith("body:"):
                in_body = True
                body_lines.append(f[len("body:"):].strip())
            elif f.startswith("author:"):
                in_body = False
            elif in_body:
                body_lines.append(f)
        c["body"] = "\n".join(body_lines).strip()
        out.append(c)
    return out


HUNK_APPLY_JSON_RE = re.compile(r"\{\"comments\":\[.*\]\}", re.S)
HUNK_APPLIED_RE = re.compile(
    r"^\s*- (mcp:[\w-]+:\d+) on (.+?):(\d+) \((new|moved)\) hunk (\d+)$", re.M
)


def _parse_apply(cmd, stdout):
    """comment apply 명령의 JSON + 결과 stdout -> 응답 배열."""
    m = HUNK_APPLY_JSON_RE.search(cmd or "")
    if not m:
        return []
    try:
        entries = json.loads(m.group(0).replace("'\\''", "'")).get("comments") or []
    except ValueError:
        return []
    applied = HUNK_APPLIED_RE.findall(stdout or "")
    out = []
    for k, c in enumerate(entries):
        if not isinstance(c, dict):
            continue
        line, status = c.get("newLine"), ""
        if k < len(applied) and applied[k][1] == c.get("filePath"):
            line = line or int(applied[k][2])
            status = applied[k][3]
        out.append(
            {"file": c.get("filePath") or "", "line": line, "status": status,
             "summary": c.get("summary") or "", "rationale": c.get("rationale") or ""}
        )
    return out


def _file_match(abs_path, rel_path):
    """diff의 절대경로와 hunk 코멘트의 repo 상대경로를 잇는다."""
    return abs_path == rel_path or abs_path.endswith("/" + rel_path)


def _hunk_reviews(events):
    """이벤트 순회로 리뷰 스레드 조립. 스레드 = (사이클, 파일). (01 조립 규칙)"""
    threads = []
    cycle = None  # 파일 -> 스레드 (열린 사이클)
    seen = set()
    pending_apply = []  # 아직 결과를 못 만난 apply 명령 (FIFO)
    last_diff = {}  # 파일 -> [ev, part] 마지막 diff (원본 hunk 복원용)
    for i, ev in enumerate(events):
        for j, p in enumerate(ev["parts"]):
            if p["type"] == "file_diff":
                for rel, th in (cycle or {}).items():
                    if _file_match(p["file"], rel):
                        th["fixes"].append([i, j])
                last_diff[p["file"]] = [i, j]
            elif p.get("hunk") == "apply":
                if p["type"] == "tool_use":
                    pending_apply.append(
                        (p.get("input") or {}).get("command") or ""
                    )
                elif p["type"] == "tool_result" and pending_apply:
                    replies = _parse_apply(
                        pending_apply.pop(0), p.get("text") or ""
                    )
                    for r in replies:
                        th = cycle.get(r["file"]) if cycle else None
                        if not th:
                            # 리네임 등으로 파일 매칭 실패 → 응답 단독 스레드
                            th = {"file": r["file"], "ev": i, "comments": [],
                                  "fixes": [], "replies": [], "origin": None}
                            threads.append(th)
                        th["replies"].append(r)
                    if replies:
                        cycle = None
            elif p.get("hunk") == "list" and p["type"] == "tool_result":
                fresh = [
                    c for c in _parse_comment_list(p.get("text") or "")
                    if c["id"] not in seen
                ]
                if not fresh:
                    continue
                cycle = {}
                for c in fresh:
                    seen.add(c["id"])
                    th = cycle.get(c["file"])
                    if not th:
                        origin = max(
                            (loc for f, loc in last_diff.items()
                             if _file_match(f, c["file"])),
                            default=None,
                        )
                        th = {"file": c["file"], "ev": i, "comments": [],
                              "fixes": [], "replies": [], "origin": origin}
                        cycle[c["file"]] = th
                        threads.append(th)
                    th["comments"].append(
                        {k: c[k] for k in ("id", "hunk", "range", "body", "created")}
                    )
    return threads


def parse_session(path, redact=False):
    """jsonl -> 뷰어가 그리는 이벤트 배열."""
    events = []
    tool_names = {}
    tool_turns = {}  # tool_use id -> 턴 번호 (서브에이전트 diff를 부모 턴에 붙일 때)
    tool_hunk = {}  # tool_use id -> hunk CLI 종류 (리뷰 스레드 조립용)
    pending_ask = {}  # tool_use id -> (그 이벤트의 parts, tool_use 파트, questions)
    skill_uses = {}  # Skill tool_use id -> 스킬 이름
    meta = {"id": os.path.basename(path)[:-6], "cwd": "", "branch": "", "path": path}
    counts = {"user": 0, "assistant": 0, "tool": 0, "sidechain": 0, "thinking": 0}
    turn = 0

    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue

            meta["cwd"] = meta["cwd"] or e.get("cwd") or ""
            meta["branch"] = meta["branch"] or e.get("gitBranch") or ""
            etype = e.get("type")
            if etype not in ("user", "assistant"):
                continue

            side = bool(e.get("isSidechain"))
            msg = e.get("message") or {}
            content = msg.get("content")
            if isinstance(content, str):
                content = [{"type": "text", "text": content}]
            if not isinstance(content, list):
                continue

            # 진짜 지시만 턴 경계다 (02 실측 + 04가 좁힌 정의)
            if (
                etype == "user"
                and not side
                and not e.get("isMeta")
                and opens_turn(content)
            ):
                turn += 1

            # Skill 툴이 주입한 스킬 안내문이면 이름 달린 접이식 파트로 만든다.
            skill_name = (
                skill_uses.get(e.get("sourceToolUseID")) if etype == "user" else None
            )
            parts = []
            for p in content:
                if not isinstance(p, dict):
                    continue
                t = p.get("type")
                if t == "text":
                    raw = p.get("text") or ""
                    cmd = CMD_RE.search(raw)
                    if cmd:
                        a = CMD_ARGS_RE.search(raw)
                        parts.append(
                            {
                                "type": "command",
                                "name": " ".join(cmd.group(1).split()),
                                "args": " ".join(a.group(1).split()) if a else "",
                            }
                        )
                    out = STDOUT_RE.search(raw)
                    if out and out.group(1).strip():
                        parts.append(
                            {"type": "tool_result", "name": "출력", "error": False,
                             "text": clip(out.group(1).strip())}
                        )
                    body = strip_noise(raw).strip()
                    name = skill_name
                    if not name and e.get("isMeta") and body.startswith(SKILL_PREFIX):
                        # 슬래시 커맨드로 트리거된 스킬: 경로 첫 줄에서 이름을 뽑는다.
                        first = body.split("\n", 1)[0][len(SKILL_PREFIX):]
                        name = os.path.basename(first.strip().rstrip("/")) or "skill"
                    if body and name:
                        parts.append(
                            {"type": "skill", "name": name, "text": clip(body)}
                        )
                    elif body:
                        parts.append({"type": "text", "text": clip(body)})
                elif t == "thinking":
                    think = (p.get("thinking") or "").strip()
                    if think:
                        counts["thinking"] += 1
                        parts.append({"type": "thinking", "text": clip(think)})
                elif t == "tool_use":
                    tool_names[p.get("id")] = p.get("name")
                    tool_turns[p.get("id")] = turn
                    counts["tool"] += 1
                    inp = p.get("input")
                    if isinstance(inp, dict):
                        inp = dict(
                            (k, clip(v) if isinstance(v, str) else v)
                            for k, v in inp.items()
                        )
                    part = {
                        "type": "tool_use",
                        "name": p.get("name") or "tool",
                        "input": inp,
                    }
                    if p.get("name") == "Bash" and isinstance(inp, dict):
                        hk = _hunk_kind(inp.get("command") or "")
                        if hk:
                            part["hunk"] = hk
                            tool_hunk[p.get("id")] = hk
                    parts.append(part)
                    if p.get("name") == "Skill" and isinstance(inp, dict):
                        skill_uses[p.get("id")] = inp.get("skill") or "skill"
                    if p.get("name") == "AskUserQuestion":
                        qs = (p.get("input") or {}).get("questions")
                        if isinstance(qs, list):
                            pending_ask[p.get("id")] = (parts, part, qs)
                elif t == "tool_result":
                    ask = pending_ask.pop(p.get("tool_use_id"), None)
                    tur = e.get("toolUseResult")
                    answers = tur.get("answers") if isinstance(tur, dict) else None
                    if ask and isinstance(answers, dict):
                        # 질문·답변 쌍은 툴 표시 대신 ask 파트 하나로 합친다.
                        src_parts, src_part, qs = ask
                        src_parts.remove(src_part)
                        counts["tool"] -= 1
                        parts.append(
                            {
                                "type": "ask",
                                "items": [
                                    {
                                        "question": q.get("question") or "",
                                        "header": q.get("header") or "",
                                        "answer": answers.get(q.get("question"), ""),
                                    }
                                    for q in qs
                                ],
                            }
                        )
                        continue
                    tname = tool_names.get(p.get("tool_use_id"), "")
                    fd = file_diff_part(tname, tur, bool(p.get("is_error")))
                    if fd:
                        parts.append(fd)
                        continue
                    tr = {
                        "type": "tool_result",
                        "name": tname,
                        "error": bool(p.get("is_error")),
                        "text": clip(result_text(p.get("content"))),
                    }
                    hk = tool_hunk.get(p.get("tool_use_id"))
                    if hk:
                        tr["hunk"] = hk
                    parts.append(tr)
                elif t == "image":
                    parts.append({"type": "text", "text": "(이미지)"})

            if not parts:
                continue

            if side:
                counts["sidechain"] += 1
            elif etype == "user":
                if any(p["type"] == "text" for p in parts):
                    counts["user"] += 1
            else:
                counts["assistant"] += 1

            events.append(
                {
                    "role": etype,
                    "ts": e.get("timestamp") or "",
                    "side": side,
                    "meta": bool(e.get("isMeta")),
                    "model": (msg.get("model") or "") if etype == "assistant" else "",
                    "skill": e.get("attributionSkill") or "",
                    "turn": turn,
                    "parts": parts,
                }
            )

    for ev in _subagent_events(path, tool_turns, turn):
        counts["sidechain"] += 1
        # 부모 턴의 마지막 이벤트 뒤에 끼워 턴 묶음을 연속으로 유지한다.
        i = max(
            (j for j, x in enumerate(events) if x["turn"] == ev["turn"]),
            default=len(events) - 1,
        )
        events.insert(i + 1, ev)

    data = {"meta": meta, "counts": counts, "events": events,
            "reviews": _hunk_reviews(events)}
    if redact:
        data = json.loads(redact_text(json.dumps(data, ensure_ascii=False)))
    return data


def redact_text(s):
    s = s.replace(HOME.replace("/", "\\/"), "~")
    s = s.replace(HOME, "~")
    user = os.path.basename(HOME)
    s = re.sub(r"/Users/%s\b" % re.escape(user), "~", s)
    return s


