VIEWER_JS = r"""
const esc = s => String(s == null ? '' : s)
  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

/* 줄임 모드는 CSS 로 못 막는 것(높이 애니메이션·스무스 스크롤)까지 끈다 */
const REDUCED = matchMedia('(prefers-reduced-motion: reduce)');
const SCROLL_BEHAVIOR = () => REDUCED.matches ? 'auto' : 'smooth';

/* 마크다운 렌더러 — GFM 수준까지 커버, 코드 하이라이팅은 기각 (05 결정).
   처리 순서가 곧 안전장치다:
     1) esc  2) 펜스 코드블록 추출  3) 인라인 코드 추출  → 이후 어떤 인라인 규칙도
     코드 내부를 건드리지 못한다(인라인코드 안의 **가 볼드로 먹히던 버그도 함께 사라진다).
   자리표시자는 raw NUL이 아니라 \u0000 이스케이프 — HTML 파서가 script 안의 raw NUL을
   U+FFFD로 바꾼다. */

function mdLink(href, text){
  return '<a href="' + href + '" target="_blank" rel="noopener">' + text + '</a>';
}

function mdInline(t){
  return t
    .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
    // 닫는 *는 공백 뒤에 올 수 없다(CommonMark) — `*.ts, *.js` 같은 glob 오탐 차단
    .replace(/(^|[^*\w])\*([^*\s](?:[^*\n]*[^*\s])?)\*(?!\*)/g, '$1<em>$2</em>')
    .replace(/~~([^~\n]+)~~/g, '<del>$1</del>')
    .replace(/\[([^\]\n]*)\]\((https?:[^)\s]+)\)/g,
      (m0, txt, url) => mdLink(url, txt || url))
    // 맨 URL 자동 링크 — 위에서 만든 <a href="…">보다 뒤에 오지만
    // 선행 문자를 줄머리·공백·( 로 못박아 href 안을 다시 잡지 않는다.
    .replace(/(^|[\s(])(https?:\/\/[^\s<>"'`)\]]+)/g, (m0, pre, url) => {
      const tail = (url.match(/[.,;:!?]+$/) || [''])[0];
      const u = url.slice(0, url.length - tail.length);
      return pre + mdLink(u, u) + tail;
    });
}

function mdCells(s){
  let t = s.trim();
  if (t.startsWith('|')) t = t.slice(1);
  if (t.endsWith('|')) t = t.slice(0, -1);
  return t.split('|').map(c => c.trim());
}

function mdRow(cells, align, tag){
  return '<tr>' + cells.map((c, k) =>
    '<' + tag + (align[k] ? ' style="text-align:' + align[k] + '"' : '') + '>'
    + mdInline(c) + '</' + tag + '>').join('') + '</tr>';
}

function mdBlocks(lines){
  const out = [], stack = [];
  let para = [], quote = null;
  const flushPara = () => {
    // GFM 줄바꿈: 빈 줄만 문단을 나누고, 문단 안 줄바꿈은 <br>로 보존
    if (para.length) { out.push('<p>' + para.map(mdInline).join('<br>') + '</p>'); para = []; }
  };
  const closeLists = () => { while (stack.length) out.push('</li></' + stack.pop().tag + '>'); };
  const flushQuote = () => {
    if (quote) { out.push('<blockquote>' + mdBlocks(quote) + '</blockquote>'); quote = null; }
  };
  const flushAll = () => { flushPara(); closeLists(); flushQuote(); };

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].replace(/\s+$/, '');

    // esc()가 이미 돌았으므로 인용 마커는 '>'가 아니라 '&gt;'다
    const bq = line.match(/^ {0,3}&gt;\s?(.*)$/);
    if (bq) { flushPara(); closeLists(); (quote = quote || []).push(bq[1]); continue; }
    if (quote) flushQuote();

    if (!line.trim()) { flushPara(); closeLists(); continue; }

    if (/^\u0000B\d+\u0000$/.test(line.trim())) { flushAll(); out.push(line.trim()); continue; }

    // 수평선 — 파이프가 없어야 하므로 표 구분선과 겹치지 않는다
    if (/^ {0,3}(?:-{3,}|\*{3,}|_{3,})$/.test(line.trim())) { flushAll(); out.push('<hr>'); continue; }

    const h = line.match(/^ {0,3}(#{1,6})\s+(.*?)\s*#*$/);
    if (h) {
      flushAll();
      const n = h[1].length;
      out.push('<h' + n + '>' + mdInline(h[2]) + '</h' + n + '>');
      continue;
    }

    // GFM 표 — 다음 줄이 구분선일 때만 표로 인정
    const next = lines[i + 1];
    if (line.indexOf('|') >= 0 && next && next.indexOf('|') >= 0
        && /^[\s|:-]*-[\s|:-]*$/.test(next)) {
      flushAll();
      const align = mdCells(next).map(c =>
        /^:.*:$/.test(c) ? 'center' : /:$/.test(c) ? 'right' : '');
      const head = mdCells(line);
      const body = [];
      i += 2;
      for (; i < lines.length && lines[i].trim() && lines[i].indexOf('|') >= 0; i++)
        body.push(mdCells(lines[i]));
      i--;
      out.push('<div class="tw"><table><thead>' + mdRow(head, align, 'th')
        + '</thead><tbody>' + body.map(r => mdRow(r, align, 'td')).join('')
        + '</tbody></table></div>');
      continue;
    }

    const li = line.match(/^(\s*)(?:([-*+])|(\d+)[.)])\s+(.*)$/);
    if (li) {
      flushPara(); flushQuote();
      const ind = li[1].replace(/\t/g, '    ').length;
      const tag = li[2] ? 'ul' : 'ol';
      const cb = li[4].match(/^\[([ xX])\]\s+(.*)$/);
      const cls = cb ? ' class="task"' : '';
      const inner = cb
        ? '<input type="checkbox" disabled' + (cb[1] === ' ' ? '' : ' checked') + '> '
          + mdInline(cb[2])
        : mdInline(li[4]);
      while (stack.length && ind < stack[stack.length - 1].ind)
        out.push('</li></' + stack.pop().tag + '>');
      if (!stack.length || ind > stack[stack.length - 1].ind) {
        stack.push({tag: tag, ind: ind});
        out.push('<' + tag + '>');            // 열린 <li> 안에 들어가 중첩이 된다
      } else if (stack[stack.length - 1].tag !== tag) {
        out.push('</li></' + stack.pop().tag + '>');
        stack.push({tag: tag, ind: ind});
        out.push('<' + tag + '>');
      } else {
        out.push('</li>');
      }
      out.push('<li' + cls + '>' + inner);
      continue;
    }

    // 리스트 항목에 이어지는 들여쓴 줄 — <ul> 안에 <p>를 흘리지 않는다
    if (stack.length && /^\s{2,}\S/.test(line)) { out.push('<br>' + mdInline(line.trim())); continue; }

    closeLists();
    para.push(line);
  }
  flushAll();
  return out.join('\n');
}

function md(src){
  const B = [], S = [];
  const s = esc(src == null ? '' : src)
    // 여는 울타리와 같은 길이로 닫아야 ````markdown 처럼 4개짜리 펜스에서
    // 백틱 한 개가 본문으로 새지 않는다
    .replace(/(`{3,})(\w*)\n?([\s\S]*?)\1/g, (m0, fence, lang, code) => {
      B.push('<pre class="cb"><code>' + code.replace(/\n$/, '') + '</code></pre>');
      return '\u0000B' + (B.length - 1) + '\u0000';
    })
    .replace(/`([^`\n]+)`/g, (m0, c) => {
      S.push('<code>' + c + '</code>');
      return '\u0000S' + (S.length - 1) + '\u0000';
    });
  return mdBlocks(s.split('\n'))
    .replace(/\u0000S(\d+)\u0000/g, (m0, k) => S[+k])
    .replace(/\u0000B(\d+)\u0000/g, (m0, k) => B[+k]);
}

const TOOL_ARG = {
  Bash: i => i.command, Read: i => i.file_path, Edit: i => i.file_path,
  Write: i => i.file_path, Glob: i => i.pattern, Grep: i => i.pattern,
  Task: i => i.description, Agent: i => i.description, Skill: i => i.skill,
  WebFetch: i => i.url, WebSearch: i => i.query, TodoWrite: () => '',
};

function toolArg(name, input){
  if (!input || typeof input !== 'object') return '';
  const f = TOOL_ARG[name];
  if (f) { const v = f(input); if (v) return String(v).split('\n')[0]; }
  const k = ['file_path','path','command','query','pattern','description','prompt','url']
    .find(k => typeof input[k] === 'string');
  return k ? String(input[k]).split('\n')[0] : '';
}

function toolBody(name, input){
  if (!input || typeof input !== 'object') return '<pre class="raw">'+esc(input)+'</pre>';
  if (name === 'Bash' && input.command)
    return '<pre class="raw">$ '+esc(input.command)+'</pre>'
      + (input.description ? '<div class="sub">'+esc(input.description)+'</div>' : '');
  return '<pre class="raw">'+esc(JSON.stringify(input, null, 2))+'</pre>';
}

function diffStats(p){
  if (p.create) return {add: String(p.content || '').split('\n').length, del: 0};
  let add = 0, del = 0;
  for (const h of p.patch || []) for (const l of h.lines || []) {
    if (l[0] === '+') add++; else if (l[0] === '-') del++;
  }
  return {add, del};
}

function statHtml(s){
  return '<span class="plus">+'+s.add+'</span> <span class="minus">−'+s.del+'</span>';
}

function hunkHtml(p){
  const rows = [];
  const row = (cls, o, n, mark, body) =>
    '<tr'+(cls ? ' class="'+cls+'"' : '')+'><td class="ln">'+(o || '')+'</td>'
    + '<td class="ln">'+(n || '')+'</td><td class="dl">'+mark+' '+body+'</td></tr>';
  if (p.create) {
    String(p.content || '').split('\n').forEach((l, i) =>
      rows.push(row('add', '', i + 1, '+', esc(l))));
  } else {
    for (const h of p.patch || []) {
      rows.push('<tr class="hh"><td class="ln"></td><td class="ln"></td><td class="dl">'
        + '@@ -'+h.oldStart+','+h.oldLines+' +'+h.newStart+','+h.newLines+' @@</td></tr>');
      let o = h.oldStart, n = h.newStart;
      for (const l of h.lines || []) {
        const c = l[0], body = esc(l.slice(1));
        if (c === '+') rows.push(row('add', '', n++, '+', body));
        else if (c === '-') rows.push(row('del', o++, '', '-', body));
        else rows.push(row('', o++, n++, '&nbsp;', body));
      }
    }
  }
  return '<table class="dt">'+rows.join('')+'</table>';
}

/* 세션 cwd 기준 상대경로. 워크트리에서는 cwd 가 곧 리포 루트라 리포 상대와 같다.
   바깥 파일은 홈만 ~ 로 접는다. 전체 경로는 title 로 남긴다. */
function relPath(f){
  const meta = (window.__CCS && window.__CCS.data.meta) || {};
  const cwd = (meta.cwd || '').replace(/\/+$/, '');
  if (cwd && f.startsWith(cwd + '/')) return f.slice(cwd.length + 1);
  return f.replace(/^\/Users\/[^/]+/, '~');
}

function fdHead(p){
  const s = diffStats(p);
  const full = p.file || '';
  const file = relPath(full);
  const cut = file.lastIndexOf('/') + 1;
  return '<span class="fh-tool">'+esc(p.tool)+'</span>'
    + '<span class="fh-path" title="'+esc(full)+'"><span class="dir">'
    + esc(file.slice(0, cut))+'</span><b>'+esc(file.slice(cut))+'</b></span>'
    + (p.create ? '<span class="badge">새 파일</span>' : '')
    + (p.userModified ? '<span class="badge">수동수정</span>' : '')
    + '<span class="fh-stat">'+statHtml(s)+'</span>';
}

function fdCard(p){
  return '<details class="fd"><summary class="fd-h">'+fdHead(p)+'</summary>'+hunkHtml(p)+'</details>';
}

function renderPart(p){
  if (p.hunk && window.__HIDE_HUNK) return '';  // 리뷰 마커·탭이 hunk CLI를 대신한다
  if (p.type === 'file_diff') return fdCard(p);
  if (p.type === 'tool_use' && (p.name === 'Edit' || p.name === 'Write'))
    return '';  // diff 카드가 호출·결과를 대신한다
  if (p.type === 'text')
    return p.text ? '<div class="md">'+md(p.text)+'</div>' : '';
  if (p.type === 'command')
    return '<div class="cmd"><code>'+esc(p.name)+'</code>'
      + (p.args ? ' <span class="arg">'+esc(p.args)+'</span>' : '') + '</div>';
  if (p.type === 'ask')
    return '<div class="ask">' + p.items.map(it =>
      '<div class="ask-q">'
      + (it.header ? '<span class="badge">'+esc(it.header)+'</span>' : '')
      + esc(it.question) + '</div>'
      + '<div class="ask-a">' + (it.answer ? esc(it.answer) : '(무응답)') + '</div>'
    ).join('') + '</div>';
  if (p.type === 'skill')
    return '<details class="skill"><summary><strong>/'+esc(p.name)+'</strong>'
      + '<span class="arg">스킬 안내</span></summary>'
      + '<div class="body"><div class="md">'+md(p.text)+'</div></div></details>';
  if (p.type === 'thinking')
    return '<details class="think"><summary>사고 과정</summary><div class="body">'
      + '<div class="md">'+md(p.text)+'</div></div></details>';
  if (p.type === 'tool_use') {
    const arg = toolArg(p.name, p.input);
    return '<details class="tool"><summary><strong>'+esc(p.name)+'</strong>'
      + (arg ? '<span class="arg">'+esc(arg)+'</span>' : '') + '</summary>'
      + '<div class="body">'+toolBody(p.name, p.input)+'</div></details>';
  }
  if (p.type === 'tool_result') {
    const n = (p.text || '').split('\n').length;
    return '<details class="tool result'+(p.error?' err':'')+'"><summary><strong>'
      + esc(p.error ? '오류' : '결과') + '</strong><span class="arg">'
      + esc(p.name || '') + ' · ' + n + '줄</span></summary>'
      + '<div class="body"><pre class="raw">'+esc(p.text)+'</pre></div></details>';
  }
  return '';
}

function fmtHM(ts){
  const d = new Date(ts);
  return isNaN(d) ? '' : String(d.getHours()).padStart(2,'0')
    + ':' + String(d.getMinutes()).padStart(2,'0');
}

function renderEvent(e, i){
  const isUser = e.role === 'user';
  const hasText = e.parts.some(p => p.type === 'text' && p.text);
  const hasCmd = e.parts.some(p => p.type === 'command');
  const hasAsk = e.parts.some(p => p.type === 'ask');
  const hasSkill = e.parts.some(p => p.type === 'skill');
  const hasDiff = e.parts.some(p => p.type === 'file_diff');
  const onlyTool = !hasText && !hasCmd && !hasAsk && !hasSkill;
  const cls = ['ev', isUser ? 'user' : 'assistant'];
  if (e.side) cls.push('side');
  if (hasDiff) cls.push('has-diff');
  else if (onlyTool) cls.push('tool-only');
  if (e.meta) cls.push('is-meta');
  const said = hasText || hasCmd;  // /명령도 내가 한 말이다 — 같은 카드로 낸다
  const who = !isUser ? 'Claude'
    : said ? '나' : hasAsk ? '질문·답변'
    : hasSkill ? '스킬' : hasDiff ? '파일 변경' : '툴 결과';
  const badges = [];
  if (e.side) badges.push('<span class="badge">'
    + (e.agent ? '서브에이전트 · '+esc(e.agent) : '서브에이전트')+'</span>');
  if (e.skill) badges.push('<span class="badge">/'+esc(e.skill)+'</span>');
  if (e.model) badges.push('<span class="badge">'+esc(e.model)+'</span>');
  const ts = said && e.ts ? '<span class="ts">' + esc(fmtHM(e.ts)) + '</span>' : '';
  const body = e.parts.map(p => renderPart(p)).join('');
  if (!body.trim()) return '';
  const inner = (isUser && said)
    ? '<div class="bubble">'+body+'</div>' : body;
  return '<div class="'+cls.join(' ')+'" data-i="'+i+'">'
    + '<div class="who">'+who+ts+badges.join('')+'</div>'+inner+'</div>';
}

function renderTurns(evs, byEv){
  const turns = [];
  evs.forEach((e, i) => {
    const last = turns[turns.length - 1];
    if (!last || last.turn !== e.turn) turns.push({turn: e.turn, items: []});
    turns[turns.length - 1].items.push([e, i]);
  });
  return turns.map(t =>
    '<section class="turn" data-turn="'+t.turn+'">'
    + t.items.map(([e, i]) => {
        const ths = (byEv && byEv[i]) || [];
        return renderEvent(e, i) + (ths.length ? rvMarker(ths) : '');
      }).join('')+'</section>'
  ).join('');
}

/* hunk-review 리뷰 스레드: 대화 탭에는 마커, 리뷰 탭에 스레드 카드 (06 결정) */

function fdAt(loc){
  const d = window.__CCS.data;
  const p = loc && d.events[loc[0]] && d.events[loc[0]].parts[loc[1]];
  return p && p.type === 'file_diff' ? p : null;
}

function rvAnchor(th){
  const c = th.comments[0];
  if (c && c.range) return 'L' + c.range[0];
  if (c && c.hunk != null) return 'hunk ' + c.hunk;
  const r = th.replies[0];
  return r && r.line ? 'L' + r.line : '';
}

function rvHead(th, resolved){
  const full = th.file || '';
  const file = relPath(full);
  const cut = file.lastIndexOf('/') + 1;
  const anchor = rvAnchor(th);
  const agentOnly = !th.comments.length;
  return '<span class="badge">'+(agentOnly ? 'Claude 코멘트' : '리뷰')+'</span>'
    + '<span class="fh-path" title="'+esc(full)+'"><span class="dir">'
    + esc(file.slice(0, cut))+'</span><b>'+esc(file.slice(cut))+'</b></span>'
    + (anchor ? '<span class="rv-anchor">'+esc(anchor)+'</span>' : '')
    + (agentOnly ? '' : '<span class="rv-state '+(resolved ? 'done' : 'open')+'">'
       + (resolved ? '응답 완료' : '응답 없음')+'</span>');
}

function rvBody(th){
  const out = [];
  const o = fdAt(th.origin);
  if (o) out.push('<div class="rv-label">리뷰 대상 (직전 변경에서 복원)</div>'+fdCard(o));
  for (const c of th.comments)
    out.push('<div class="rv-c"><div class="who-s">나'
      + (c.hunk != null ? ' · hunk '+c.hunk : '')
      + (c.range ? ' · L'+c.range[0] : '')+'</div>'
      + '<div class="md">'+md(c.body)+'</div></div>');
  const fixes = th.fixes.map(fdAt).filter(Boolean);
  if (fixes.length) {
    out.push('<div class="rv-label">수정 '+fixes.length+'건</div>');
    for (const p of fixes) out.push(fdCard(p));
  }
  for (const r of th.replies)
    out.push('<div class="rv-r"><div class="sum">↳ '+esc(r.summary)
      + (r.line ? ' <span class="rv-anchor">:'+r.line+'</span>' : '')+'</div>'
      + (r.rationale ? '<div class="rat">'+md(r.rationale)+'</div>' : '')+'</div>');
  return out.join('');
}

function rvCard(th){
  const resolved = th.replies.length > 0;
  return '<div id="rv-'+th.i+'" class="rv'+(th.comments.length ? '' : ' rv-agent')+'">'
    + '<div class="rv-h">'+rvHead(th, resolved)+'</div>'
    + '<div class="rv-body">'+rvBody(th)+'</div></div>';
}

function rvMarker(ths){
  const names = ths.map(th => (th.file || '').split('/').pop());
  const label = names.slice(0, 2).join(', ') + (names.length > 2 ? ' 외 '+(names.length-2) : '');
  return '<div class="rv-mk" role="button" tabindex="0" data-go="rv-'+ths[0].i+'">'
    + '리뷰 스레드 '+ths.length+'건 · <b>'+esc(label)+'</b> — 리뷰 탭에서 보기</div>';
}

function reviewPanel(reviews){
  if (!reviews.length) return '<div class="empty">리뷰 스레드 없음</div>';
  const byFile = new Map();
  for (const th of reviews) {
    if (!byFile.has(th.file)) byFile.set(th.file, []);
    byFile.get(th.file).push(th);
  }
  const out = [];
  for (const [file, ths] of byFile) {
    out.push('<div class="rvp-f" title="'+esc(file)+'">'+esc(relPath(file))+'</div>');
    for (const th of ths) out.push(rvCard(th));
  }
  return out.join('');
}

function renderSession(data, mount){
  window.__CCS = {data, mount};
  mount.classList.remove('empty');
  mount.style.opacity = '0';   // "불러오는 중…" → 본문 하드컷을 없앤다 (끝에서 되돌림)
  const evs = data.events || [];
  const reviews = data.reviews || [];
  reviews.forEach((th, i) => { th.i = i; });   // 마커 → 스레드 카드 앵커
  const c = data.counts || {};
  const box = n => document.querySelector('[data-f="'+n+'"]');
  const toggle = (n, on) => { const el = box(n); if (el) el.closest('label').classList.toggle('hidden', !on); };
  toggle('think', (c.thinking || 0) > 0);
  toggle('side', (c.sidechain || 0) > 0);
  window.__HIDE_HUNK = reviews.length > 0;
  if (reviews.length) {
    const byEv = {};
    reviews.forEach(th => (byEv[th.ev] = byEv[th.ev] || []).push(th));
    mount.innerHTML =
      '<div class="rv-tabs"><button class="on" data-tab="conv">대화</button>'
      + '<button data-tab="rv">리뷰 '+reviews.length+'</button><i class="ind"></i></div>'
      + '<div id="tab-conv">'+renderTurns(evs, byEv)+'</div>'
      + '<div id="tab-rv" class="hidden">'+reviewPanel(reviews)+'</div>';
    // 밑줄은 CSS 변수(상속 → 자식 전체 재계산) 대신 인디케이터에 직접 transform 을 준다
    const ind = mount.querySelector('.rv-tabs .ind');
    const place = () => {
      const on = mount.querySelector('.rv-tabs button.on');
      if (!on) return;
      ind.style.width = on.offsetWidth + 'px';
      ind.style.transform = 'translateX(' + on.offsetLeft + 'px)';
    };
    const pick = tab => {
      mount.querySelectorAll('.rv-tabs button').forEach(x =>
        x.classList.toggle('on', x.dataset.tab === tab));
      document.getElementById('tab-conv').classList.toggle('hidden', tab !== 'conv');
      document.getElementById('tab-rv').classList.toggle('hidden', tab !== 'rv');
      place();
    };
    mount.querySelectorAll('.rv-tabs button').forEach(b => {
      b.onclick = () => pick(b.dataset.tab);
    });
    // 마커는 "리뷰 탭 맨 위"가 아니라 그 스레드로 데려가야 한다 — 공간 연속성
    mount.querySelectorAll('.rv-mk').forEach(mk => {
      const go = () => {
        pick('rv');
        const t = document.getElementById(mk.dataset.go);
        if (!t) { window.scrollTo({top: 0, behavior: SCROLL_BEHAVIOR()}); return; }
        t.scrollIntoView({behavior: SCROLL_BEHAVIOR(), block: 'center'});
        mount.querySelectorAll('.rv.flash').forEach(x => x.classList.remove('flash'));
        void t.offsetWidth;                       // 연속 클릭에도 다시 재생되게
        t.classList.add('flash');
        t.addEventListener('animationend',
          () => t.classList.remove('flash'), {once: true});
      };
      mk.onclick = go;
      mk.onkeydown = e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
      };
    });
    ind.style.transition = 'none';                // 첫 배치는 움직이지 않는다
    place();
    requestAnimationFrame(() => { ind.style.transition = ''; });
    addEventListener('resize', place);
  } else {
    mount.innerHTML = renderTurns(evs);
  }
  // 그룹핑 → 필터 → 항해 장치 순서. 필터는 버스트를 통째로 껐다 켜므로 그룹핑 뒤라야 하고,
  // 항해 장치는 DOM 재배치가 끝난 뒤에 헤더를 승격해야 한다. (04)
  groupAll(mount);
  applyFilters();
  setupNav(mount);
  requestAnimationFrame(() => { mount.style.opacity = ''; });
}

function applyFilters(){
  const f = name => {
    const el = document.querySelector('[data-f="'+name+'"]');
    return el ? el.checked : true;
  };
  const showTools = f('tools'), showThink = f('think'), showSide = f('side');
  document.querySelectorAll('.burst').forEach(b =>
    b.classList.toggle('hidden', !showTools));
  document.querySelectorAll('.ev').forEach(ev => {
    let hide = false;
    if (!showTools && ev.classList.contains('tool-only')) hide = true;
    if (!showSide && ev.classList.contains('side')) hide = true;
    ev.classList.toggle('hidden', hide);
    ev.querySelectorAll('details.tool').forEach(d => d.classList.toggle('hidden', !showTools));
    ev.querySelectorAll('details.think').forEach(d => d.classList.toggle('hidden', !showThink));
  });
}

/* ── 03 활동 버스트 압축 ────────────────────────────────────────────
   연속 활동 버스트(활동 3건 이상)를 접힌 요약 한 줄로 강등한다.
   렌더 결과 위에 얹는 후처리라 renderPart/renderEvent는 무변경. */

const CAT = {
  탐색: ['Read','Glob','Grep','WebFetch','WebSearch','ToolSearch','NotebookRead','LSP'],
  실행: ['Bash','BashOutput','KillShell'],
  위임: ['Task','Agent','Skill','Workflow'],
  변경: ['Edit','Write','NotebookEdit'],   // 성공분은 diff 카드가 되고, 실패분만 여기 남는다
};
const CAT_ORDER = ['탐색','실행','위임','기타'];
const MIN_ITEMS = 3;   // 활동 3건 미만은 묶지 않는다 (버스트의 17~30%가 도구 1개 — 실측)
const TEXTY = new Set(['text','command','ask','skill']);

function catOf(name){
  for (const c of Object.keys(CAT)) if (CAT[c].includes(name)) return c;
  return '기타';
}

function isActivityEv(ev){ return ev && !ev.parts.some(p => TEXTY.has(p.type)); }

function fmtDur(ms){
  if (!(ms > 0)) return '';
  const s = Math.round(ms / 1000);
  if (s < 60) return s + '초';
  const mn = Math.floor(s / 60);
  if (mn < 60) return mn + '분' + (s % 60 ? ' ' + (s % 60) + '초' : '');
  return Math.floor(mn / 60) + '시간' + (mn % 60 ? ' ' + (mn % 60) + '분' : '');
}

function burstStats(els){
  const evs = (window.__CCS && window.__CCS.data.events) || [];
  const st = {tools: 0, cats: {}, files: new Map(), add: 0, del: 0,
              err: 0, think: 0, t0: null, t1: null};
  for (const el of els) {
    const ev = evs[+el.dataset.i];
    if (!ev) continue;
    if (ev.ts) { st.t0 = st.t0 || ev.ts; st.t1 = ev.ts; }
    for (const p of ev.parts) {
      if (p.type === 'tool_use') {
        if (p.name === 'Edit' || p.name === 'Write') continue;  // diff 카드가 대신함
        st.cats[catOf(p.name)] = (st.cats[catOf(p.name)] || 0) + 1;
        st.tools++;
      } else if (p.type === 'file_diff') {
        const s = diffStats(p);
        st.add += s.add; st.del += s.del;
        st.files.set(p.file, (st.files.get(p.file) || 0) + 1);
      } else if (p.type === 'tool_result') { if (p.error) st.err++; }
      else if (p.type === 'thinking') st.think++;
    }
  }
  st.items = st.tools + st.files.size + st.think;
  st.ms = (st.t0 && st.t1) ? (new Date(st.t1) - new Date(st.t0)) : 0;
  return st;
}

function burstHead(st){
  const bits = ['<span class="b-n">활동 ' + st.items + '</span>'];
  for (const c of CAT_ORDER) if (st.cats[c]) bits.push(c + ' ' + st.cats[c]);
  if (st.files.size) bits.push('파일 ' + st.files.size + '개 <span class="plus">+' + st.add
    + '</span> <span class="minus">−' + st.del + '</span>');
  if (st.think) bits.push('사고 ' + st.think);
  let h = bits.join('<span class="b-sep"> · </span>');
  if (st.err) h += '<span class="b-sep"> · </span><span class="b-err">오류 ' + st.err + '</span>';
  const d = fmtDur(st.ms);
  return h + (d ? '<span class="b-t">' + d + '</span>' : '');
}

function makeBurst(els, st){
  const b = document.createElement('div');
  b.className = 'burst' + (st.err ? ' has-err' : '');
  b.innerHTML = '<div class="burst-h" role="button" tabindex="0" aria-expanded="false">'
    + burstHead(st) + '</div>'
    + '<div class="burst-body" hidden="until-found"><div class="burst-in">'
    + '<div class="b-all"><button data-x="open">모두 펼치기</button>'
    + '<button data-x="close">모두 접기</button></div></div></div>';
  els[0].before(b);
  const head = b.querySelector('.burst-h');
  const body = b.querySelector('.burst-body');
  const inner = b.querySelector('.burst-in');
  for (const el of els) inner.appendChild(el);   // 원본 시간순 그대로
  // 펼침은 세션당 수십 번 — 짧게. 접기는 시스템 응답이므로 더 빠르게(비대칭).
  // 아주 긴 버스트는 기다리는 편이 튀는 것보다 나쁘므로 애니메이션을 건너뛴다.
  const OPEN_MS = 180, CLOSE_MS = 140, MAX_ANIM = 900;
  let anim = null;
  const set = (open, animate) => {
    b.classList.toggle('open', open);
    head.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (anim) { anim.cancel(); anim = null; }
    if (open) body.removeAttribute('hidden');
    const h = body.scrollHeight;
    if (!animate || REDUCED.matches || h > MAX_ANIM) {
      if (!open) body.setAttribute('hidden', 'until-found');
      return;
    }
    anim = body.animate(
      [{height: (open ? 0 : h) + 'px', opacity: open ? 0 : 1},
       {height: (open ? h : 0) + 'px', opacity: open ? 1 : 0}],
      {duration: open ? OPEN_MS : CLOSE_MS, easing: 'cubic-bezier(.23,1,.32,1)'});
    anim.onfinish = () => {
      anim = null;
      if (!open) body.setAttribute('hidden', 'until-found');
    };
  };
  head.onclick = () => set(!b.classList.contains('open'), true);
  head.onkeydown = e => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault(); set(!b.classList.contains('open'), true);
    }
  };
  // 브라우저 Ctrl+F가 접힌 안을 찾아 펼칠 때 요약 줄의 상태도 맞춘다 (04 ⑤)
  // 찾기 결과로 튀어나오는 것이지 사용자가 연 게 아니므로 애니메이션은 없다.
  body.addEventListener('beforematch', () => set(true, false));
  inner.querySelector('[data-x=open]').onclick =
    () => inner.querySelectorAll('details').forEach(d => d.open = true);
  inner.querySelector('[data-x=close]').onclick =
    () => inner.querySelectorAll('details').forEach(d => d.open = false);
  return b;
}

function groupAll(mount){
  const evs = (window.__CCS && window.__CCS.data.events) || [];
  for (const turn of mount.querySelectorAll('.turn')) {
    let run = [];
    const flush = () => {
      if (run.length) {
        const st = burstStats(run);
        if (st.items >= MIN_ITEMS) makeBurst(run, st);
      }
      run = [];
    };
    for (const k of Array.from(turn.children)) {
      const ok = k.classList && k.classList.contains('ev') && !k.classList.contains('side')
        && isActivityEv(evs[+k.dataset.i]);
      if (ok) run.push(k); else flush();
    }
    flush();
  }
}

/* ── 04 항해 장치 ───────────────────────────────────────────────────
   ① 턴을 여는 지시 카드 헤더만 sticky  ② 붙어 있는 동안만 지시 축약 표기
   ③ 2px 진행바 + 턴 눈금(클릭 점프·hover 라벨) — 이 눈금이 목차를 흡수한다
   ④ 턴 정의는 parse_session이 좁혀 넘긴 값(진짜 지시만)을 그대로 쓴다 */

const NAV = {turns: [], hh: 0, raf: 0, lraf: 0, bound: false};

function headerH(){
  const hd = document.querySelector('header');
  return hd ? Math.round(hd.getBoundingClientRect().height) : 0;
}

const OPENER_SEL = ':scope > .bubble > .md, :scope > .bubble > .cmd';

function turnOpener(sec){
  const kids = [...sec.children].filter(el => el.classList
    && el.classList.contains('ev') && el.classList.contains('user')
    && !el.classList.contains('side'));
  // 본문 있는 발화가 1순위 (04, opens_turn과 같은 정의)
  for (const el of kids) if (el.querySelector(':scope > .bubble > .md')) return el;
  // 슬래시 커맨드로만 시작한 세션(턴 0)도 항해 장치를 갖게 한다 — 실측상 이런 세션은
  // 첫 3,000px 에 진행바·눈금·sticky 가 통째로 없었다. /clear 류 잡음만 제외한다.
  for (const el of kids) {
    const c = el.querySelector(':scope > .bubble > .cmd');
    if (c && !/^\/(clear|compact|resume|exit)\b/.test(c.textContent.trim())) return el;
  }
  return null;
}

function setupNav(mount){
  const hd = document.querySelector('header');
  if (!hd || !mount) return;
  const old = document.getElementById('prog');
  if (old) old.remove();
  NAV.turns = [];

  const bar = document.createElement('div');
  bar.id = 'prog';
  bar.innerHTML = '<div id="progfill"></div><div id="progtip"></div>';
  hd.appendChild(bar);
  const fill = bar.querySelector('#progfill');
  const tip = bar.querySelector('#progtip');

  mount.querySelectorAll('.turn').forEach(sec => {
    const op = turnOpener(sec);
    if (!op) return;
    const src = op.querySelector(OPENER_SEL);
    NAV.turns.push({sec: sec, op: op,
      label: (src ? src.textContent : '').trim().replace(/\s+/g, ' ')});
  });
  const total = NAV.turns.length;
  if (!total) return;

  NAV.turns.forEach((t, i) => {
    t.op.classList.add('turn-open');
    // 지시 헤더를 카드 밖으로 승격 — sticky 범위를 턴 전체로 넓힌다 (04 ①)
    const who = t.op.querySelector(':scope > .who');
    if (who) {
      // 시각(.ts)과 지시요약(.tnav)을 같은 grid cell 에 겹쳐 넣는다 — display 스위치가
      // 아니라 opacity 교체가 되고, 행 너비가 붙는 순간마다 튀지 않는다 (04 ②)
      const swap = document.createElement('span');
      swap.className = 'swap';
      const ts = who.querySelector(':scope > .ts');
      const s = document.createElement('span');
      s.className = 'tnav';
      s.innerHTML = '<b>' + (i + 1) + '/' + total + '</b> · ' + esc(t.label.slice(0, 140));
      if (ts) swap.appendChild(ts);
      swap.appendChild(s);
      who.appendChild(swap);
      who.classList.add('turn-head');
      t.op.before(who);
      t.head = who;
    }
    const label = (i + 1) + '. ' + (t.label.slice(0, 140) || '(빈 지시)');
    const tick = document.createElement('button');
    tick.type = 'button';
    tick.className = 'tick';
    tick.setAttribute('aria-label', label);
    const show = () => {
      tip.textContent = label;
      tip.classList.add('on');
      const x = parseFloat(tick.style.left) || 0;
      tip.style.left =
        Math.max(8, Math.min(x - 24, bar.clientWidth - tip.offsetWidth - 8)) + 'px';
    };
    const hide = () => tip.classList.remove('on');
    tick.onclick = () =>
      t.sec.scrollIntoView({behavior: SCROLL_BEHAVIOR(), block: 'start'});
    tick.onmouseenter = show;
    tick.onmouseleave = hide;
    tick.onfocus = show;
    tick.onblur = hide;
    bar.appendChild(tick);
    t.tick = tick;
  });

  const scrollMax = () =>
    Math.max(1, document.documentElement.scrollHeight - window.innerHeight);

  const layout = () => {
    const hh = headerH();
    document.documentElement.style.setProperty('--hh', hh + 'px');
    NAV.hh = hh;
    const w = bar.clientWidth || 1, max = scrollMax();
    let prev = -99;
    for (const t of NAV.turns) {
      const top = t.sec.getBoundingClientRect().top + window.scrollY - hh - 12;
      let x = Math.min(1, Math.max(0, top / max)) * w;
      if (x - prev < 7) x = prev + 7;   // 최대 43턴 — 눈금이 겹치지 않게 최소 간격 클램프
      prev = x = Math.min(x, w - 6);    // 눈금 반폭만큼 남겨 문서 가로 스크롤을 만들지 않는다
      t.tick.style.left = x + 'px';
    }
  };
  NAV.layout = layout;

  // 진행 채움 + stuck 판정. IntersectionObserver sentinel은 눈금 클릭 같은 즉시 점프에서
  // 경계 통과 프레임이 통째로 건너뛰어져 콜백이 안 오므로, 스크롤마다 직접 잰다. (04 ②)
  const paint = () => {
    NAV.raf = 0;
    const hh = NAV.hh;
    fill.style.width = (Math.min(1, window.scrollY / scrollMax()) * 100) + '%';
    for (const t of NAV.turns) {
      if (!t.head) continue;
      const r = t.sec.getBoundingClientRect();
      t.head.classList.toggle('stuck', r.top < hh - 1 && r.bottom > hh);
    }
  };

  if (!NAV.bound) {
    NAV.bound = true;
    addEventListener('scroll', () => {
      if (!NAV.raf) NAV.raf = requestAnimationFrame(paint);
    }, {passive: true});
    addEventListener('resize', () => navRelayout());
    if (window.ResizeObserver) new ResizeObserver(() => navRelayout()).observe(document.body);
  }
  layout();
  paint();
}

function navRelayout(){
  if (NAV.lraf || !NAV.layout) return;
  NAV.lraf = requestAnimationFrame(() => { NAV.lraf = 0; NAV.layout(); });
}

document.addEventListener('change', e => {
  if (e.target.matches('[data-f]')) applyFilters();
});
